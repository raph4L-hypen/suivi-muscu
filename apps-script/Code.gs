 0; }\n  .sport-chip.on { background: var(--sport-accent-dim); color: var(--sport-accent); }\n  .sport-chip.red { background: var(--sport-red-dim); color: var(--sport-red); }\n  .sport-badge { font-size: 12px; font-weight: 700; padding: 3px 8px; border-radius: 8px; background: var(--sport-card2); color: var(--sport-mute); }\n  .up { color: var(--sport-accent); } .down { color: var(--sport-red); } .flat { color: var(--sport-mute); }\n  .sport-btn { display: block; width: 100%; padding: 15px; border-radius: 14px; font-weight: 700; font-size: 16px;\n    background: var(--sport-card2); text-align: center; }\n  .sport-btn.primary { background: var(--sport-accent); color: #04140a; }\n  .sport-btn.danger { background: var(--sport-red-dim); color: var(--sport-red); }\n  .sport-btn.small { padding: 10px; font-size: 14px; }\n  .sport-big { font-size: 28px; font-weight: 800; letter-spacing: -.5px; }\n  .sport-mute { color: var(--sport-mute); font-size: 13px; }\n  label.sport-lbl { display: block; color: var(--sport-mute); font-size: 13px; margin: 12px 0 6px; }\n\n  /* ---------- Accueil ---------- */\n  .sport-chart { width: 100%; height: auto; display: block; }\n  .sport-seance { display: block; width: 100%; text-align: left; }\n  .sport-seance .t { font-weight: 700; font-size: 17px; }\n  .sport-note { min-width: 44px; text-align: center; font-weight: 800; font-size: 15px; padding: 6px 8px; border-radius: 10px; }\n  .n-good { background: var(--sport-accent-dim); color: var(--sport-accent); }\n  .n-mid { background: rgba(245, 184, 61, .15); color: var(--sport-amber); }\n  .n-bad { background: var(--sport-red-dim); color: var(--sport-red); }\n  .sport-empty { text-align: center; color: var(--sport-mute); padding: 30px 10px; }\n\n  /* Ma semaine (agenda) */\n  .sport-wkhead { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }\n  .sport-wkhead button.arrow { width: 38px; height: 38px; border-radius: 10px; background: var(--sport-card2); font-size: 20px; font-weight: 700; color: var(--sport-accent); }\n  .sport-week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }\n  .sport-day { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 8px 0 7px; border-radius: 12px; background: var(--sport-card2); border: 2px solid transparent; }\n  .sport-day .dn { font-size: 11px; color: var(--sport-mute); text-transform: capitalize; }\n  .sport-day .dd { font-size: 17px; font-weight: 800; }\n  .sport-day .lab { font-size: 9.5px; font-weight: 700; letter-spacing: -.2px; }\n  .sport-day.today { border-color: var(--sport-text); }\n  .sport-day.sel { background: #2a303b; }\n  .sport-day.t-seance { background: var(--sport-accent-dim); } .sport-day.t-seance .lab { color: var(--sport-accent); }\n  .sport-day.t-sport { background: var(--sport-blue-dim); } .sport-day.t-sport .lab { color: var(--sport-blue); }\n  .sport-day.t-repos .lab { color: var(--sport-mute); }\n  .sport-day.sel.t-seance { background: rgba(47, 215, 122, .3); } .sport-day.sel.t-sport { background: rgba(77, 163, 255, .3); }\n  .sport-daydetail { margin-top: 10px; font-size: 14px; }\n  .sport-ev { display: flex; gap: 10px; align-items: baseline; padding: 6px 0; border-top: 1px solid var(--sport-line); }\n  .sport-ev .h { color: var(--sport-mute); font-size: 12px; min-width: 78px; font-variant-numeric: tabular-nums; }\n  .sport-ev.seance b { color: var(--sport-accent); } .sport-ev.sport b { color: var(--sport-blue); }\n\n  /* ---------- Overlays ---------- */\n  .sport-overlay { position: fixed; inset: 0; background: var(--sport-bg); z-index: 40; overflow-y: auto;\n    padding: 16px 16px 40px; animation: sportIn .22s ease-out; }\n  @keyframes sportIn { from { transform: translateY(16px); opacity: 0; } to { transform: none; opacity: 1; } }\n  .sport-back { font-size: 15px; color: var(--sport-accent); font-weight: 600; padding: 6px 0; }\n\n  /* Tableau UA */\n  table.sport-ua { width: 100%; border-collapse: collapse; font-size: 15px; }\n  table.sport-ua th { color: var(--sport-mute); font-weight: 600; font-size: 12px; text-align: center; padding: 6px 2px; }\n  table.sport-ua td { text-align: center; padding: 6px 2px; border-top: 1px solid var(--sport-line); }\n  table.sport-ua tr.total td { font-weight: 800; border-top: 2px solid var(--sport-line); }\n  .sport-step { display: inline-flex; align-items: center; background: var(--sport-card2); border-radius: 10px; }\n  .sport-step button { width: 34px; height: 40px; font-size: 20px; font-weight: 700; color: var(--sport-accent); }\n  .sport-step input { width: 52px; padding: 8px 0; text-align: center; border: 0; background: transparent; font-weight: 700; font-size: 16px; }\n  .sport-step input:focus { outline: none; }\n\n  /* ---------- D\u00e9marrer ---------- */\n  .sport-go-wrap { display: flex; flex-direction: column; align-items: center; padding-top: 6vh; }\n  .sport-go { width: 62vw; height: 62vw; max-width: 260px; max-height: 260px; border-radius: 50%;\n    background: radial-gradient(circle at 35% 30%, #5cf09c, var(--sport-accent) 60%, #17a659);\n    color: #04140a; font-size: 64px; font-weight: 900; letter-spacing: 2px;\n    box-shadow: 0 0 0 10px var(--sport-accent-dim), 0 18px 50px rgba(47, 215, 122, .35); }\n  .sport-go:active { transform: scale(.96); }\n  .sport-today { text-align: center; margin: 26px 0 18px; }\n  .sport-choose { padding: 12px 22px; border-radius: 999px; background: var(--sport-card2); font-weight: 600; font-size: 15px; }\n\n  /* ---------- S\u00e9ance en cours ---------- */\n  #sport-run { padding-top: 64px; z-index: 50; }\n  #sport-clock { position: fixed; left: 50%; top: 14px; transform: translateX(-50%); z-index: 60;\n    font-size: 26px; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: 1px;\n    transition: top .8s cubic-bezier(.2, .8, .2, 1), font-size .8s cubic-bezier(.2, .8, .2, 1); pointer-events: none; }\n  #sport-clock.intro { top: 34%; font-size: 26vw; }\n  #sport-clock.paused { color: var(--sport-amber); }\n  .sport-runbar { position: fixed; top: 0; left: 0; right: 0; height: 58px; display: flex; align-items: center;\n    justify-content: space-between; padding: 0 14px; background: var(--sport-bg); z-index: 55; border-bottom: 1px solid var(--sport-line); }\n  .sport-pausebtn { width: 40px; height: 40px; border-radius: 50%; background: var(--sport-red); color: #fff; font-size: 14px; font-weight: 900; }\n  .sport-runbody { transition: opacity .4s; }\n  .sport-runbody.wait { opacity: 0; }\n  .sport-visual { display: flex; gap: 10px; align-items: center; justify-content: center; background: var(--sport-card); border-radius: var(--sport-radius); padding: 10px; }\n  .sport-visual img { max-width: 45%; max-height: 150px; border-radius: 10px; object-fit: contain; background: #fff; }\n  .sport-bodymap { flex: 1 1 auto; width: 100%; max-width: 300px; min-width: 200px; height: auto; }\n  .sport-gauge { height: 10px; border-radius: 6px; background: var(--sport-card2); overflow: hidden; margin-top: 8px; }\n  .sport-gauge div { height: 100%; background: var(--sport-accent); transition: width .3s; }\n  .sport-rest { text-align: center; padding: 10px 0 4px; }\n  .sport-rest .cd { font-size: 22vw; font-weight: 900; font-variant-numeric: tabular-nums; line-height: 1; }\n  .sport-rest .cd.over { color: var(--sport-red); }\n  .sport-fixedcta { position: sticky; bottom: 0; padding: 12px 0 4px; background: linear-gradient(transparent, var(--sport-bg) 30%); }\n  .sport-finish { font-size: 22px; padding: 18px; }\n  .sport-pause-ov { position: fixed; inset: 0; background: rgba(8, 9, 12, .94); z-index: 58; display: flex;\n    flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 30px; }\n  .sport-seg { display: flex; background: var(--sport-card2); border-radius: 12px; padding: 4px; }\n  .sport-seg button { flex: 1; padding: 10px; border-radius: 9px; font-weight: 600; color: var(--sport-mute); }\n  .sport-seg button.on { background: var(--sport-accent); color: #04140a; }\n  input[type=range] { padding: 0; accent-color: var(--sport-accent); border: 0; background: transparent; }\n\n  /* Toast + chargement */\n  #sport-toast { position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%) translateY(20px); opacity: 0;\n    background: #2a2f3a; padding: 10px 16px; border-radius: 12px; font-size: 14px; z-index: 99; transition: all .25s; pointer-events: none; max-width: 90vw; }\n  #sport-toast.show { opacity: 1; transform: translateX(-50%); }\n  #sport-toast.err { background: var(--sport-red); }\n  #sport-loading { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 98; background: var(--sport-bg); color: var(--sport-mute); }\n  .sport-spinner { width: 36px; height: 36px; border: 3px solid var(--sport-line); border-top-color: var(--sport-accent); border-radius: 50%; animation: sportSpin .8s linear infinite; }\n  @keyframes sportSpin { to { transform: rotate(360deg); } }\n  .sport-exrow { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; }\n  .sport-mini { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 8px; }\n  .sport-mini label { font-size: 11px; color: var(--sport-mute); display: block; margin-bottom: 3px; }\n  .sport-mini input { padding: 8px; text-align: center; }\n  .sport-icons button { width: 34px; height: 34px; border-radius: 8px; background: var(--sport-card2); font-size: 14px; }\n\n  /* =================== TH\u00c8ME PREMIUM (verre, n\u00e9on, profondeur) =================== */\n  h1 { font-weight: 800; letter-spacing: -.8px; }\n  h2 { font-weight: 800; letter-spacing: -.3px; color: #e9ece9; }\n  .sport-card { background: rgba(22, 25, 30, .8); border: 1px solid rgba(255,255,255,.06);\n    box-shadow: 0 10px 30px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.05); border-radius: 20px; }\n  input, select, textarea { background: rgba(0,0,0,.35); border-color: rgba(255,255,255,.08); }\n  .sport-chip.on { box-shadow: inset 0 0 0 1px rgba(57,255,142,.35); }\n  .sport-btn.primary { background: linear-gradient(180deg, #5cffa6, #2fe07c); color: #03150a;\n    box-shadow: 0 0 0 1px rgba(57,255,142,.5), 0 8px 26px rgba(57,255,142,.35), inset 0 1px 0 rgba(255,255,255,.5); }\n  .sport-gauge div { box-shadow: var(--sport-glow); }\n  .up { text-shadow: 0 0 10px rgba(57,255,142,.45); }\n\n  /* Effet \"bouton qui s'enfonce\" sur tout ce qui se touche */\n  button, .sport-seance, .sport-day, .sport-step button { transition: transform .14s cubic-bezier(.3, .7, .4, 1), box-shadow .14s, filter .14s, background .2s; }\n  button:active:not(:disabled) { transform: scale(.955) translateY(1px); filter: brightness(.92); }\n  button.sport-card:active { transform: scale(.975) translateY(2px);\n    box-shadow: 0 3px 10px rgba(0,0,0,.5), inset 0 2px 8px rgba(0,0,0,.45); }\n  .sport-go:active { transform: scale(.94) !important; box-shadow: 0 0 0 6px var(--sport-accent-dim), 0 6px 20px rgba(57,255,142,.3), inset 0 6px 16px rgba(0,0,0,.25) !important; }\n  #sport-tabs button:active { transform: scale(.88); }\n\n  /* Cartes de s\u00e9ance avec visuel r\u00e9el */\n  .sport-seance { display: grid !important; grid-template-columns: 1fr auto; gap: 12px; align-items: center; }\n  .sport-thumb { width: 74px; height: 74px; border-radius: 16px; background: #fff center/cover no-repeat;\n    box-shadow: 0 6px 16px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.08); overflow: hidden; }\n  .sport-thumb.ph { background: radial-gradient(circle at 30% 30%, rgba(57,255,142,.35), rgba(57,255,142,.05) 70%); display: flex; align-items: center; justify-content: center; }\n  .sport-thumb.ph svg { width: 60%; height: 60%; }\n  .sport-seance .t { font-size: 18px; font-weight: 800; letter-spacing: -.3px; }\n  .sport-strip { display: flex; gap: 6px; margin-top: 10px; }\n  .sport-strip span { width: 44px; height: 44px; border-radius: 11px; background: #fff center/cover no-repeat; box-shadow: 0 0 0 1px rgba(255,255,255,.08); }\n\n  /* Panneaux qui glissent depuis le bord droit, plus sombres, par-dessus l'accueil */\n  .sport-overlay { background: rgba(9, 10, 12, .9); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);\n    box-shadow: -30px 0 60px rgba(0,0,0,.8), -1px 0 0 rgba(57,255,142,.2); animation: sportSlide .42s cubic-bezier(.2, .85, .2, 1); padding-bottom: 60px; }\n  .sport-overlay.closing { animation: sportSlideOut .3s cubic-bezier(.4, 0, .8, .4) forwards; }\n  @keyframes sportSlide { from { transform: translateX(100%); } to { transform: none; } }\n  @keyframes sportSlideOut { to { transform: translateX(100%); } }\n  #sport-run { background: rgba(6, 7, 8, .93); }\n\n  /* Page S\u00e9ance : GO n\u00e9on devant le logo */\n  .sport-go { position: relative; background: radial-gradient(circle at 35% 28%, #8dffbf, #39ff8e 45%, #12b85a 100%);\n    color: #021208; font-weight: 900; letter-spacing: 4px;\n    box-shadow: 0 0 0 10px rgba(57,255,142,.10), 0 0 0 1px rgba(57,255,142,.6), 0 0 60px rgba(57,255,142,.55), inset 0 -10px 24px rgba(0,0,0,.25), inset 0 6px 14px rgba(255,255,255,.45);\n    animation: sportPulse 2.6s ease-in-out infinite; }\n  @keyframes sportPulse { 50% { box-shadow: 0 0 0 16px rgba(57,255,142,.05), 0 0 0 1px rgba(57,255,142,.6), 0 0 90px rgba(57,255,142,.7), inset 0 -10px 24px rgba(0,0,0,.25), inset 0 6px 14px rgba(255,255,255,.45); } }\n  .sport-choose { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.08); backdrop-filter: blur(12px); }\n\n  /* Animation du logo au lancement d'une s\u00e9ance */\n  #sport-launch { position: fixed; inset: 0; z-index: 70; display: flex; align-items: center; justify-content: center;\n    background: radial-gradient(circle at 50% 45%, #0f2a1b, #050607 58%); animation: sportFade .3s ease-out; }\n  #sport-launch svg { width: 74vw; max-width: 340px; animation: sportLogoIn 1.5s cubic-bezier(.2, .9, .2, 1) forwards; }\n  #sport-launch .plate { stroke-dasharray: 700; stroke-dashoffset: 700; animation: sportDraw .9s .15s ease-out forwards; }\n  #sport-launch .bar { stroke-dasharray: 900; stroke-dashoffset: 900; animation: sportDraw .7s .45s ease-out forwards; }\n  #sport-launch .go { opacity: 0; animation: sportFadeIn .4s .85s forwards; }\n  #sport-launch.out { animation: sportFadeOut .35s ease-in forwards; }\n  @keyframes sportLogoIn { 0% { transform: scale(.55) rotate(-30deg); filter: drop-shadow(0 0 0 rgba(57,255,142,0)); }\n    55% { transform: scale(1.08) rotate(-16deg); filter: drop-shadow(0 0 40px rgba(57,255,142,.9)); }\n    100% { transform: scale(1) rotate(-18deg); filter: drop-shadow(0 0 24px rgba(57,255,142,.6)); } }\n  @keyframes sportDraw { to { stroke-dashoffset: 0; } }\n  @keyframes sportFade { from { opacity: 0; } }\n  @keyframes sportFadeIn { to { opacity: 1; } }\n  @keyframes sportFadeOut { to { opacity: 0; transform: scale(1.15); } }\n  #sport-clock { text-shadow: 0 0 18px rgba(57,255,142,.55); }\n  .sport-runbar { background: rgba(6,7,8,.8); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }\n  .sport-pausebtn { box-shadow: 0 0 18px rgba(255,77,79,.6); }\n  .sport-rest .cd { text-shadow: 0 0 30px rgba(57,255,142,.4); }\n\n  /* Biblioth\u00e8que par groupe musculaire */\n  .sport-group { margin: 18px 0 8px; display: flex; align-items: center; justify-content: space-between; }\n  .sport-group h3 { margin: 0; font-size: 15px; letter-spacing: .3px; text-transform: uppercase; color: var(--sport-accent); text-shadow: 0 0 12px rgba(57,255,142,.35); }\n  .sport-group .n { color: var(--sport-mute); font-weight: 600; font-size: 12px; margin-left: 6px; text-transform: none; text-shadow: none; }\n  .sport-libadd { width: 34px; height: 34px; border-radius: 11px; background: var(--sport-accent-dim); color: var(--sport-accent); font-size: 20px; font-weight: 700; box-shadow: inset 0 0 0 1px rgba(57,255,142,.3); }\n  .sport-exitem { display: grid; grid-template-columns: 52px 1fr auto; gap: 12px; align-items: center; width: 100%; text-align: left; padding: 8px; border-radius: 16px; }\n  .sport-exitem + .sport-exitem { margin-top: 6px; }\n  .sport-exitem .sport-thumb { width: 52px; height: 52px; border-radius: 13px; }\n  .sport-exitem b { display: block; font-size: 15px; }\n  .sport-exitem:active { background: rgba(255,255,255,.05); }\n  .sport-imgbox { margin-top: 6px; display: grid; grid-template-columns: 110px 1fr; gap: 12px; align-items: center; }\n  .sport-imgbox .prev { width: 110px; height: 110px; border-radius: 18px; background: #fff center/contain no-repeat; box-shadow: 0 0 0 1px rgba(255,255,255,.1); }\n  .sport-imgbox .prev.empty { background: rgba(255,255,255,.05); display: flex; align-items: center; justify-content: center; color: var(--sport-mute); font-size: 12px; text-align: center; padding: 8px; }\n  .sport-imgbox .sport-btn { margin-bottom: 8px; }\n</style>\n\n</head>\n<body>\n  <div id=\"sport-app\">\n    <!-- Fond : salle de sport flout\u00e9e + logo en transparence -->\n    <div id=\"sport-bg\">\n      <div id=\"sport-bgphoto\"></div>\n      <div id=\"sport-bgshade\"></div>\n      <div id=\"sport-bglogo\"></div>\n    </div>\n\n    <div id=\"sport-loading\"><div class=\"sport-spinner\"></div><p>Chargement\u2026</p></div>\n\n    <main id=\"sport-pager\">\n      <section class=\"sport-page\" id=\"sport-pg-start\"></section>\n      <section class=\"sport-page\" id=\"sport-pg-home\"></section>\n      <section class=\"sport-page\" id=\"sport-pg-prog\"></section>\n    </main>\n\n    <nav id=\"sport-tabs\">\n      <button data-page=\"0\" aria-label=\"S\u00e9ance\">\n        <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9.2\"/><path d=\"M10 8.4v7.2l6-3.6z\" class=\"fill\"/></svg>\n      </button>\n      <button data-page=\"1\" class=\"on\" aria-label=\"Accueil\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M3 12h3.6l2.2-5 3.6 10 2.4-6.2 1.6 1.2H21\"/></svg>\n      </button>\n      <button data-page=\"2\" aria-label=\"Programme\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M3.5 9.5v5M6.5 7v10M17.5 7v10M20.5 9.5v5M6.5 12h11\"/></svg>\n      </button>\n      <span id=\"sport-tabglow\"></span>\n    </nav>\n\n    <div id=\"sport-sheet\" class=\"sport-overlay hidden\"></div>\n    <div id=\"sport-run\" class=\"sport-overlay hidden\"></div>\n    <div id=\"sport-launch\" class=\"hidden\"></div>\n    <div id=\"sport-clock\" class=\"hidden\">00:00</div>\n    <div id=\"sport-toast\"></div>\n  </div>\n  <script>\n/* =====================================================================\n   SUIVI MUSCU \u2014 logique de l'appli (c\u00f4t\u00e9 t\u00e9l\u00e9phone)\n   ===================================================================== */\n(function () {\n  'use strict';\n\n  /* ---------- Outils ---------- */\n  const $ = (s, el = document) => el.querySelector(s);\n  const esc = s => String(s == null ? '' : s).replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n  const num = v => { const n = parseFloat(String(v).replace(',', '.')); return isNaN(n) ? 0 : n; };\n  const fmt = n => Math.round(n).toLocaleString('fr-FR');\n  const fmtKg = n => (Math.round(n * 10) / 10).toLocaleString('fr-FR');\n  const mmss = ms => { const s = Math.max(0, Math.floor(ms / 1000)); const h = Math.floor(s / 3600); const m = Math.floor(s % 3600 / 60); const r = s % 60;\n    return (h ? h + ':' + String(m).padStart(2, '0') : String(m).padStart(2, '0')) + ':' + String(r).padStart(2, '0'); };\n  const dateFr = iso => new Date(iso).toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' });\n  const dateCourt = iso => new Date(iso).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });\n  const pct = (a, b) => b ? Math.round((a - b) / b * 100) : 0;\n  const store = {\n    get(k) { try { return JSON.parse(localStorage.getItem(k)); } catch (e) { return null; } },\n    set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { } },\n    del(k) { try { localStorage.removeItem(k); } catch (e) { } }\n  };\n  function toast(msg, err) {\n    const t = $('#sport-toast'); t.textContent = msg; t.className = 'show' + (err ? ' err' : '');\n    clearTimeout(toast._t); toast._t = setTimeout(() => t.className = '', err ? 4000 : 2200);\n  }\n  function api(fn, ...args) {\n    return new Promise((res, rej) => {\n      google.script.run.withSuccessHandler(res).withFailureHandler(e => { toast('Erreur : ' + (e && e.message || e), true); rej(e); })[fn](...args);\n    });\n  }\n\n  const MUSCLES = {\n    pectoraux: 'Pectoraux', epaules: '\u00c9paules', deltoides_post: \"Arri\u00e8re d'\u00e9paule\", biceps: 'Biceps', triceps: 'Triceps',\n    avant_bras: 'Avant-bras', abdos: 'Abdos', obliques: 'Obliques', dorsaux: 'Dorsaux', trapezes: 'Trap\u00e8zes',\n    lombaires: 'Lombaires', fessiers: 'Fessiers', quadriceps: 'Quadriceps', ischios: 'Ischios', adducteurs: 'Adducteurs', mollets: 'Mollets'\n  };\n  const splitM = s => String(s || '').split(',').map(x => x.trim()).filter(Boolean);\n  const GROUPS = [['Pectoraux', ['pectoraux']], ['Dos', ['dorsaux', 'trapezes', 'lombaires']], ['\u00c9paules', ['epaules', 'deltoides_post']],\n    ['Bras', ['biceps', 'triceps', 'avant_bras']], ['Jambes', ['quadriceps', 'ischios', 'fessiers', 'adducteurs', 'mollets']], ['Abdos', ['abdos', 'obliques']]];\n  const groupOf = e => { const m = splitM(e.muscles)[0]; const g = GROUPS.find(x => x[1].includes(m)); return g ? g[0] : 'Autres'; };\n\n  /* ---------- Logo (halt\u00e8re n\u00e9on) ---------- */\n  const LOGO = `<svg viewBox=\"0 0 1024 1024\" xmlns=\"http://www.w3.org/2000/svg\"><g transform=\"rotate(-18 512 512)\" fill=\"none\" stroke-linejoin=\"round\">\n    <rect class=\"bar\" x=\"300\" y=\"494\" width=\"424\" height=\"36\" rx=\"18\" stroke=\"#fff\" stroke-width=\"14\"/>\n    <g class=\"plate\" stroke=\"#39ff8e\"><rect x=\"238\" y=\"372\" width=\"74\" height=\"280\" rx=\"30\" stroke-width=\"22\"/><rect x=\"168\" y=\"420\" width=\"62\" height=\"184\" rx=\"26\" stroke-width=\"20\"/>\n    <rect x=\"712\" y=\"372\" width=\"74\" height=\"280\" rx=\"30\" stroke-width=\"22\"/><rect x=\"794\" y=\"420\" width=\"62\" height=\"184\" rx=\"26\" stroke-width=\"20\"/></g>\n    <g class=\"go\" fill=\"#fff\" stroke=\"none\"><rect x=\"134\" y=\"492\" width=\"28\" height=\"40\" rx=\"10\"/><rect x=\"862\" y=\"492\" width=\"28\" height=\"40\" rx=\"10\"/></g></g></svg>`;\n  const LOGO_FLAT = LOGO.replace('rotate(-18 512 512)', 'rotate(0 512 512)');\n  const exImg = nom => ((X && X.exByName[nom]) || {}).image_url || '';\n  function thumb(noms) {\n    const u = noms.map(exImg).find(Boolean);\n    return u ? `<span class=\"sport-thumb\" style=\"background-image:url('${esc(u)}')\"></span>` : `<span class=\"sport-thumb ph\">${LOGO_FLAT}</span>`;\n  }\n  const strip = noms => `<div class=\"sport-strip\">${noms.map(exImg).filter(Boolean).slice(0, 5).map(u => `<span style=\"background-image:url('${esc(u)}')\"></span>`).join('')}</div>`;\n  const DEF_FOND = 'https://images.unsplash.com/photo-1590487988256-9ed24133863e?auto=format&fit=crop&w=1200&q=60';\n  function setBackground() {\n    const url = (D && D.reglages.fond_url) || DEF_FOND;\n    const ph = $('#sport-bgphoto');\n    const img = new Image();\n    img.onload = () => { ph.style.backgroundImage = `url('${url}')`; ph.classList.add('ok'); };\n    img.src = url;\n  }\n\n  /* ---------- Donn\u00e9es ---------- */\n  let D = null;           // donn\u00e9es brutes du Sheet\n  let X = null;           // donn\u00e9es index\u00e9es\n  let homeFilter = null;  // filtre de th\u00e9matique du graphique\n\n  function indexData() {\n    const exByName = {};\n    D.exercices.forEach(e => exByName[e.nom] = e);\n    const progs = D.programmes.slice().sort((a, b) => num(a.ordre) - num(b.ordre)).map(p => ({\n      ...p,\n      exos: D.programmeExercices.filter(r => r.programme_id === p.id).sort((a, b) => num(a.ordre) - num(b.ordre))\n    }));\n    const seriesBy = {};\n    D.series.forEach(s => (seriesBy[s.seance_id] = seriesBy[s.seance_id] || []).push(s));\n    const seances = D.seances.map(s => {\n      const exos = [];\n      (seriesBy[s.id] || []).forEach(r => {\n        let ex = exos.find(e => e.nom === r.exercice);\n        if (!ex) { ex = { nom: r.exercice, series: [], ua: 0 }; exos.push(ex); }\n        ex.series.push({ reps: num(r.reps), poids: num(r.poids), ua: num(r.ua) });\n        ex.ua += num(r.ua);\n      });\n      return { ...s, ua_totale: num(s.ua_totale), note: num(s.note), duree_min: num(s.duree_min), exos };\n    }).sort((a, b) => new Date(b.date) - new Date(a.date));\n    X = { exByName, progs, seances };\n  }\n\n  /** Historique d'un exercice (du plus ancien au plus r\u00e9cent) */\n  function exoHistory(nom) {\n    const out = [];\n    X.seances.slice().reverse().forEach(s => {\n      const e = s.exos.find(x => x.nom === nom);\n      if (e) out.push({ seance: s, ua: e.ua, series: e.series });\n    });\n    return out;\n  }\n  function lastPerf(nom, beforeId) {\n    const h = exoHistory(nom);\n    if (beforeId) { const i = h.findIndex(x => x.seance.id === beforeId); return i > 0 ? h[i - 1] : null; }\n    return h.length ? h[h.length - 1] : null;\n  }\n  function bodyweight() { return num(D.reglages.poids_de_corps); }\n  function uaOf(nom, reps, poids) {\n    const ex = X.exByName[nom];\n    let w = num(poids);\n    if (ex && ex.type_charge === 'poids_du_corps') w += bodyweight();\n    if (w <= 0) w = 1;\n    return num(reps) * w;\n  }\n  function trendClass(a, b) { return b == null ? 'flat' : (a >= b ? 'up' : 'down'); }\n  function seriesSummary(series) {\n    if (!series || !series.length) return '';\n    const same = series.every(s => s.reps === series[0].reps && s.poids === series[0].poids);\n    return same ? `${series.length}\u00d7${series[0].reps} @ ${fmtKg(series[0].poids)} kg` : series.map(s => `${s.reps}\u00d7${fmtKg(s.poids)}`).join(' \u00b7 ');\n  }\n  function nextProgramme() {\n    if (!X.progs.length) return null;\n    const last = X.seances[0];\n    if (!last) return X.progs[0];\n    const i = X.progs.findIndex(p => p.id === last.programme_id);\n    return X.progs[(i + 1) % X.progs.length];\n  }\n\n  /* ---------- Sch\u00e9ma musculaire (face + dos) ---------- */\n  // [forme, muscle, dx, cy, rx, ry]  \u2014 dx relatif au centre, dessin\u00e9 des 2 c\u00f4t\u00e9s\n  const FRONT = [\n    ['e', 'trapezes', -7, 31, 4, 3], ['e', 'epaules', -17, 38, 8, 7], ['e', 'pectoraux', -7, 43, 8, 7],\n    ['e', 'biceps', -22, 53, 4.5, 9], ['e', 'avant_bras', -25, 72, 4, 10], ['e', 'obliques', -13, 63, 4, 10],\n    ['e', 'adducteurs', -4, 92, 3, 9], ['e', 'quadriceps', -9, 99, 6.5, 16], ['e', 'mollets', -9, 136, 4.5, 13]\n  ];\n  const BACK = [\n    ['e', 'deltoides_post', -17, 38, 8, 7], ['e', 'triceps', -22, 53, 4.5, 9], ['e', 'avant_bras', -25, 72, 4, 10],\n    ['e', 'fessiers', -7, 87, 7.5, 7.5], ['e', 'ischios', -9, 105, 6.5, 13], ['e', 'mollets', -9, 134, 5.5, 12]\n  ];\n  function bodyFigure(cx, defs, extra, on) {\n    const base = '#262a33', off = '#3a404c', red = '#ff4d4f';\n    let s = `<circle cx=\"${cx}\" cy=\"15\" r=\"10\" fill=\"${base}\"/><rect x=\"${cx - 5}\" y=\"23\" width=\"10\" height=\"8\" fill=\"${base}\"/>`\n      + `<path d=\"M${cx - 18} 31 Q${cx} 27 ${cx + 18} 31 L${cx + 15} 80 Q${cx} 84 ${cx - 15} 80 Z\" fill=\"${base}\"/>`\n      + `<path d=\"M${cx - 15} 78 L${cx + 15} 78 L${cx + 16} 150 L${cx + 3} 150 L${cx} 92 L${cx - 3} 150 L${cx - 16} 150 Z\" fill=\"${base}\"/>`\n      + `<circle cx=\"${cx - 26}\" cy=\"86\" r=\"3.2\" fill=\"${base}\"/><circle cx=\"${cx + 26}\" cy=\"86\" r=\"3.2\" fill=\"${base}\"/>`\n      + `<ellipse cx=\"${cx - 9}\" cy=\"153\" rx=\"6\" ry=\"3\" fill=\"${base}\"/><ellipse cx=\"${cx + 9}\" cy=\"153\" rx=\"6\" ry=\"3\" fill=\"${base}\"/>`;\n    defs.forEach(d => {\n      const f = on.includes(d[1]) ? red : off;\n      [d[2], -d[2]].forEach(dx => { s += `<ellipse cx=\"${cx + dx}\" cy=\"${d[3]}\" rx=\"${d[4]}\" ry=\"${d[5]}\" fill=\"${f}\"/>`; });\n    });\n    return s + extra(cx, red, off);\n  }\n  function bodyMap(muscles) {\n    const on = Array.isArray(muscles) ? muscles : splitM(muscles);\n    const c = k => on.includes(k) ? '#ff4d4f' : '#3a404c';\n    const front = bodyFigure(50, FRONT, cx => `<rect x=\"${cx - 6}\" y=\"51\" width=\"12\" height=\"27\" rx=\"4\" fill=\"${c('abdos')}\"/>`\n      + `<line x1=\"${cx - 6}\" y1=\"60\" x2=\"${cx + 6}\" y2=\"60\" stroke=\"#262a33\"/><line x1=\"${cx - 6}\" y1=\"69\" x2=\"${cx + 6}\" y2=\"69\" stroke=\"#262a33\"/><line x1=\"${cx}\" y1=\"51\" x2=\"${cx}\" y2=\"78\" stroke=\"#262a33\"/>`, on);\n    const back = bodyFigure(150, BACK, cx => `<path d=\"M${cx} 26 L${cx - 15} 35 L${cx} 58 L${cx + 15} 35 Z\" fill=\"${c('trapezes')}\"/>`\n      + `<path d=\"M${cx - 9} 42 L${cx - 16} 46 L${cx - 12} 68 L${cx - 2} 72 L${cx - 2} 52 Z\" fill=\"${c('dorsaux')}\"/>`\n      + `<path d=\"M${cx + 9} 42 L${cx + 16} 46 L${cx + 12} 68 L${cx + 2} 72 L${cx + 2} 52 Z\" fill=\"${c('dorsaux')}\"/>`\n      + `<rect x=\"${cx - 6}\" y=\"66\" width=\"12\" height=\"12\" rx=\"3\" fill=\"${c('lombaires')}\"/>`, on);\n    return `<svg class=\"sport-bodymap\" viewBox=\"0 0 200 170\" xmlns=\"http://www.w3.org/2000/svg\">${front}${back}`\n      + `<text x=\"50\" y=\"168\" fill=\"#8b93a3\" font-size=\"9\" text-anchor=\"middle\">Face</text><text x=\"150\" y=\"168\" fill=\"#8b93a3\" font-size=\"9\" text-anchor=\"middle\">Dos</text></svg>`;\n  }\n\n  /* ---------- Graphiques SVG ---------- */\n  function lineChart(points, opts = {}) {\n    const W = opts.w || 340, H = opts.h || 160, P = opts.small ? 4 : 26;\n    if (!points.length) return `<div class=\"sport-empty\">Pas encore de donn\u00e9es</div>`;\n    const ys = points.map(p => p.y), min = Math.min(...ys), max = Math.max(...ys);\n    const lo = opts.small ? min * .95 : min - (max - min) * .15, hi = max + (max - min || max || 1) * .12;\n    const x = i => points.length === 1 ? W / 2 : P + i * (W - 2 * P) / (points.length - 1);\n    const y = v => H - P - (v - lo) / ((hi - lo) || 1) * (H - 2 * P);\n    const path = points.map((p, i) => (i ? 'L' : 'M') + x(i).toFixed(1) + ' ' + y(p.y).toFixed(1)).join(' ');\n    const area = path + ` L${x(points.length - 1)} ${H - P} L${x(0)} ${H - P} Z`;\n    let s = `<svg class=\"sport-chart\" viewBox=\"0 0 ${W} ${H}\" xmlns=\"http://www.w3.org/2000/svg\">`\n      + `<defs><linearGradient id=\"g${opts.id || 0}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#2fd77a\" stop-opacity=\".35\"/><stop offset=\"1\" stop-color=\"#2fd77a\" stop-opacity=\"0\"/></linearGradient></defs>`\n      + `<path d=\"${area}\" fill=\"url(#g${opts.id || 0})\"/><path d=\"${path}\" fill=\"none\" stroke=\"#2fd77a\" stroke-width=\"${opts.small ? 2 : 2.5}\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>`;\n    points.forEach((p, i) => {\n      const hl = i === opts.highlight;\n      if (!opts.small || hl) s += `<circle cx=\"${x(i)}\" cy=\"${y(p.y)}\" r=\"${hl ? 5 : 3.5}\" fill=\"${hl ? '#fff' : '#2fd77a'}\" stroke=\"#0e1014\" stroke-width=\"2\"/>`;\n    });\n    if (!opts.small) {\n      s += `<text x=\"${P}\" y=\"14\" fill=\"#8b93a3\" font-size=\"9\">max ${fmt(max)} UA</text>`;\n      const step = Math.ceil(points.length / 6);\n      points.forEach((p, i) => { if (i % step === 0 || i === points.length - 1) s += `<text x=\"${x(i)}\" y=\"${H - 6}\" fill=\"#8b93a3\" font-size=\"9\" text-anchor=\"middle\">${esc(p.label)}</text>`; });\n    }\n    return s + '</svg>';\n  }\n\n  /* =====================================================================\n     MA SEMAINE (agenda Google)\n     ===================================================================== */\n  let weekOffset = 0, selDay = null;\n  const agendaCache = {};\n  const DEF_SEANCE = 'musculation,muscu,salle de sport,basic fit,fitness park';\n  const DEF_SPORT = 'sport,soccer,foot,football,course,running,footing,velo,natation,piscine,tennis,padel,basket,boxe,rando,yoga,escalade,crossfit';\n  const norm = s => String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');\n  const words = s => norm(s).split(',').map(x => x.trim()).filter(Boolean);\n  const dayKey = d => { const x = new Date(d); return x.getFullYear() + '-' + String(x.getMonth() + 1).padStart(2, '0') + '-' + String(x.getDate()).padStart(2, '0'); };\n  const hhmm = ms => new Date(ms).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });\n  function mondayOf(offset) { const d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() - (d.getDay() + 6) % 7 + offset * 7); return d; }\n  function classify(title) {\n    const t = norm(title);\n    if (words(D.reglages.mots_seance || DEF_SEANCE).some(w => t.includes(w))) return 'seance';\n    if (words(D.reglages.mots_sport || DEF_SPORT).some(w => t.includes(w))) return 'sport';\n    return null;\n  }\n  function loadWeek(offset) {\n    if (agendaCache[offset]) return Promise.resolve(agendaCache[offset]);\n    const s = mondayOf(offset), e = new Date(s); e.setDate(e.getDate() + 7);\n    return new Promise((res, rej) => google.script.run.withSuccessHandler(ev => { agendaCache[offset] = ev; res(ev); })\n      .withFailureHandler(rej).getAgenda(s.getTime(), e.getTime()));\n  }\n  function buildDays(events) {\n    const start = mondayOf(weekOffset);\n    return Array.from({ length: 7 }, (_, i) => {\n      const d = new Date(start); d.setDate(d.getDate() + i);\n      const k = dayKey(d);\n      const evs = events.filter(e => dayKey(e.debut) === k).map(e => ({ ...e, type: classify(e.titre) })).filter(e => e.type);\n      const app = X.seances.filter(s => dayKey(s.date) === k);\n      const type = app.length || evs.some(e => e.type === 'seance') ? 'seance' : evs.some(e => e.type === 'sport') ? 'sport' : 'repos';\n      return { d, k, evs, app, type, also: type === 'seance' && evs.some(e => e.type === 'sport') };\n    });\n  }\n  function renderWeek() {\n    const box = $('#sport-weekbox'); if (!box) return;\n    const s = mondayOf(weekOffset), e = new Date(s); e.setDate(e.getDate() + 6);\n    const range = s.getMonth() === e.getMonth() ? `${s.getDate()} \u2013 ${e.getDate()} ${e.toLocaleDateString('fr-FR', { month: 'long' })}`\n      : `${s.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })} \u2013 ${e.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}`;\n    const title = weekOffset === 0 ? 'Cette semaine' : weekOffset === -1 ? 'Semaine derni\u00e8re' : weekOffset === 1 ? 'Semaine prochaine' : (weekOffset < 0 ? `Il y a ${-weekOffset} semaines` : `Dans ${weekOffset} semaines`);\n    let h = `<div class=\"sport-wkhead\"><button class=\"arrow\" data-wk=\"-1\" aria-label=\"Semaine pr\u00e9c\u00e9dente\">\u2039</button>\n      <div style=\"text-align:center\"><b>${title}</b><div class=\"sport-mute\">${range}</div></div>\n      <button class=\"arrow\" data-wk=\"1\" aria-label=\"Semaine suivante\">\u203a</button></div>`;\n    const ev = agendaCache[weekOffset];\n    if (!ev) {\n      box.innerHTML = h + `<div class=\"sport-mute\" style=\"text-align:center;padding:14px\">Chargement de l'agenda\u2026</div>`;\n      const off = weekOffset;\n      loadWeek(off).then(() => { if (off === weekOffset) renderWeek(); }).catch(err => {\n        if (off !== weekOffset) return;\n        box.innerHTML = h + `<div class=\"sport-mute\" style=\"padding:10px 4px\">Impossible de lire l'agenda. Dans Apps Script, lance une fois la fonction <b>autoriserAgenda</b>, puis red\u00e9ploie.<br><small>${esc(err && err.message || err)}</small></div>`;\n      });\n      return;\n    }\n    const days = buildDays(ev);\n    const today = dayKey(new Date());\n    if (!selDay || !days.some(d => d.k === selDay)) selDay = (days.find(d => d.k === today) || days[0]).k;\n    const nS = days.filter(d => d.type === 'seance').length, nP = days.filter(d => d.type === 'sport' || d.also).length;\n    h += `<div class=\"sport-week\">${days.map(d => `<button class=\"sport-day t-${d.type} ${d.k === today ? 'today' : ''} ${d.k === selDay ? 'sel' : ''}\" data-day=\"${d.k}\">\n        <span class=\"dn\">${d.d.toLocaleDateString('fr-FR', { weekday: 'short' }).replace('.', '')}</span><span class=\"dd\">${d.d.getDate()}</span>\n        <span class=\"lab\">${d.type === 'seance' ? 'S\u00e9ance' : d.type === 'sport' ? 'Sport' : 'Repos'}</span></button>`).join('')}</div>\n      <div class=\"sport-row sport-between\" style=\"margin-top:8px\"><span class=\"sport-mute\"><span class=\"up\">${nS} s\u00e9ance${nS > 1 ? 's' : ''}</span> \u00b7 <span style=\"color:var(--sport-blue)\">${nP} sport</span></span>\n      ${weekOffset !== 0 ? `<button class=\"sport-chip\" data-wk=\"0\" style=\"margin:0\">Aujourd'hui</button>` : ''}</div>`;\n    const sd = days.find(d => d.k === selDay);\n    h += `<div class=\"sport-daydetail\"><div style=\"font-weight:700;margin-bottom:4px;text-transform:capitalize\">${sd.d.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' })}</div>`;\n    if (!sd.evs.length && !sd.app.length) h += `<div class=\"sport-mute\">\ud83d\ude34 Jour de repos</div>`;\n    sd.app.forEach(s => { h += `<button class=\"sport-ev seance\" data-seance=\"${esc(s.id)}\" style=\"width:100%;text-align:left\"><span class=\"h\">\u2713 enregistr\u00e9e</span><span><b>${esc(s.thematique || 'S\u00e9ance')}</b> \u00b7 ${fmt(s.ua_totale)} UA \u203a</span></button>`; });\n    sd.evs.forEach(e => { h += `<div class=\"sport-ev ${e.type}\"><span class=\"h\">${e.journee ? 'Journ\u00e9e' : hhmm(e.debut) + '\u2013' + hhmm(e.fin)}</span><span><b>${esc(e.titre)}</b></span></div>`; });\n    box.innerHTML = h + '</div>';\n  }\n\n  /* =====================================================================\n     ACCUEIL\n     ===================================================================== */\n  function renderHome() {\n    const el = $('#sport-pg-home');\n    const themes = [...new Set(X.seances.map(s => s.thematique).filter(Boolean))];\n    if (homeFilter === null) homeFilter = X.seances[0] ? X.seances[0].thematique : 'Toutes';\n    const pts = X.seances.filter(s => homeFilter === 'Toutes' || s.thematique === homeFilter).slice(0, 20).reverse()\n      .map(s => ({ y: s.ua_totale, label: dateCourt(s.date) }));\n\n    let h = `<h1>Suivi muscu</h1><p class=\"sport-sub\">${new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' })}</p>`;\n    h += `<div class=\"sport-card\" id=\"sport-weekbox\"></div>`;\n    h += `<div class=\"sport-card\"><div class=\"sport-row sport-between\"><h3>Progression (UA par s\u00e9ance)</h3></div>`\n      + `<div class=\"sport-row sport-wrap\" style=\"margin-bottom:6px\">${['Toutes', ...themes].map(t => `<button class=\"sport-chip ${t === homeFilter ? 'on' : ''}\" data-filter=\"${esc(t)}\">${esc(t)}</button>`).join('')}</div>`\n      + lineChart(pts, { id: 'home' }) + `</div>`;\n\n    h += `<h2>Derni\u00e8res s\u00e9ances</h2>`;\n    if (!X.seances.length) h += `<div class=\"sport-card sport-empty\">Aucune s\u00e9ance pour l'instant.<br>Glisse vers la gauche et appuie sur <b>GO</b> \ud83d\udcaa</div>`;\n    X.seances.slice(0, 15).forEach(s => {\n      const prev = X.seances.find(p => p.thematique === s.thematique && new Date(p.date) < new Date(s.date));\n      const d = prev ? pct(s.ua_totale, prev.ua_totale) : null;\n      const nc = s.note >= 7 ? 'n-good' : s.note >= 5 ? 'n-mid' : 'n-bad';\n      h += `<button class=\"sport-card sport-seance\" data-seance=\"${esc(s.id)}\"><div>\n        <div class=\"sport-row sport-between\"><span class=\"sport-mute\">${dateFr(s.date)} \u00b7 ${s.duree_min} min</span><span class=\"sport-note ${nc}\">${s.note}/10</span></div>\n        <div class=\"t\">${esc(s.thematique || 'S\u00e9ance')}</div>\n        <div class=\"sport-row\" style=\"margin:6px 0\"><span class=\"sport-big\" style=\"font-size:20px\">${fmt(s.ua_totale)} UA</span>\n          ${d === null ? '' : `<span class=\"${d >= 0 ? 'up' : 'down'}\" style=\"font-weight:700\">${d >= 0 ? '\u25b2' : '\u25bc'} ${Math.abs(d)} %</span>`}</div>\n        <div class=\"sport-mute\">${s.exos.map(e => esc(e.nom)).join(', ')}</div></div>${thumb(s.exos.map(e => e.nom))}</button>`;\n    });\n    el.innerHTML = h;\n    renderWeek();\n  }\n\n  /* ---------- D\u00e9tail d'une s\u00e9ance ---------- */\n  function conseils(s) {\n    const out = [];\n    const prog = X.progs.find(p => p.id === s.programme_id);\n    let ups = 0;\n    s.exos.forEach(e => {\n      const h = exoHistory(e.nom);\n      const i = h.findIndex(x => x.seance.id === s.id);\n      const prev = i > 0 ? h[i - 1] : null, prev2 = i > 1 ? h[i - 2] : null;\n      if (!prev) return;\n      if (e.ua >= prev.ua) ups++;\n      if (e.ua < prev.ua && prev2 && prev.ua < prev2.ua) out.push(`\ud83d\udcc9 <b>${esc(e.nom)}</b> baisse 2 s\u00e9ances de suite : v\u00e9rifie ton sommeil et ta r\u00e9cup, ou fais une s\u00e9ance un peu plus l\u00e9g\u00e8re.`);\n      else if (e.ua < prev.ua) out.push(`\u2198\ufe0f <b>${esc(e.nom)}</b> : ${pct(e.ua, prev.ua)} % vs la derni\u00e8re fois. Vise au moins ${fmt(prev.ua)} UA la prochaine fois.`);\n      const pe = prog && prog.exos.find(x => x.exercice === e.nom);\n      if (pe && e.ua >= prev.ua && e.series.every(x => x.reps >= num(pe.reps))) out.push(`\u2b06\ufe0f <b>${esc(e.nom)}</b> : toutes les s\u00e9ries \u00e0 ${pe.reps} reps ou plus, ajoute 2,5 kg la prochaine fois.`);\n    });\n    if (s.exos.length && ups === s.exos.length) out.unshift('\ud83d\udd25 Toutes tes UA sont \u00e9gales ou en hausse. Objectif rempli !');\n    if (s.type === 'rapide' && s.duree_min > 55) out.push(`\u23f1\ufe0f S\u00e9ance rapide de ${s.duree_min} min : raccourcis un peu les pauses pour rester autour de 45 min.`);\n    if (s.note && s.note < 5) out.push('\ud83c\udfaf Note basse : fixe-toi un seul objectif pr\u00e9cis pour la prochaine s\u00e9ance (une charge ou un nombre de reps).');\n    if (!out.length) out.push('S\u00e9ance de r\u00e9f\u00e9rence : la prochaine fois, essaie de faire au moins autant d\\'UA sur chaque exercice.');\n    return out;\n  }\n\n  function openSeance(id) {\n    const s = X.seances.find(x => x.id === id);\n    if (!s) return;\n    const muscles = splitM(s.muscles);\n    let h = `<button class=\"sport-back\" data-close>\u2039 Retour</button>\n      <h1>${esc(s.thematique || 'S\u00e9ance')}</h1><p class=\"sport-sub\">${dateFr(s.date)}</p>\n      <div class=\"sport-row sport-wrap\">\n        <span class=\"sport-chip on\">\u23f1 ${s.duree_min} min</span>\n        <span class=\"sport-chip ${s.note >= 7 ? 'on' : s.note >= 5 ? '' : 'red'}\">\ud83c\udfaf ${s.note}/10</span>\n        <span class=\"sport-chip\">${s.accompagne === 'oui' ? '\ud83d\udc65 Accompagn\u00e9' : '\ud83e\uddcd Seul'}</span>\n        <span class=\"sport-chip\">${s.type === 'longue' ? 'Longue (1h15\u20131h35)' : 'Rapide (\u224845 min)'}</span>\n      </div>\n      <div class=\"sport-row sport-wrap\">${muscles.map(m => `<span class=\"sport-chip red\">${esc(MUSCLES[m] || m)}</span>`).join('')}</div>\n      <div class=\"sport-card\" style=\"text-align:center\"><span class=\"sport-mute\">UA totale</span><div class=\"sport-big\">${fmt(s.ua_totale)}</div></div>`;\n\n    s.exos.forEach((e, k) => {\n      const prev = lastPerf(e.nom, s.id);\n      const hist = exoHistory(e.nom);\n      const idx = hist.findIndex(x => x.seance.id === s.id);\n      const cls = trendClass(e.ua, prev && prev.ua);\n      h += `<div class=\"sport-card\"><h3>${esc(e.nom)}</h3>\n        <table class=\"sport-ua\"><tr><th>S\u00e9rie</th><th>Reps</th><th>Poids (kg)</th><th>UA</th></tr>\n        ${e.series.map((r, i) => `<tr><td>${i + 1}</td><td>${r.reps}</td><td>${fmtKg(r.poids)}</td><td>${fmt(r.ua)}</td></tr>`).join('')}\n        <tr class=\"total\"><td colspan=\"3\" style=\"text-align:left\">Total</td><td class=\"${cls}\">${fmt(e.ua)}</td></tr></table>\n        <div class=\"sport-row sport-between\" style=\"margin-top:8px\"><span class=\"sport-mute\">${prev ? `Derni\u00e8re fois : ${fmt(prev.ua)} UA` : 'Premi\u00e8re fois'}</span>\n          ${prev ? `<b class=\"${cls}\">${e.ua >= prev.ua ? '\u25b2' : '\u25bc'} ${Math.abs(pct(e.ua, prev.ua))} %</b>` : ''}</div>\n        <div style=\"margin-top:8px\">${lineChart(hist.map(x => ({ y: x.ua })), { small: true, h: 46, highlight: idx, id: 'ex' + k })}</div></div>`;\n    });\n\n    h += `<h2>Commentaires et conseils</h2><div class=\"sport-card\">\n      ${s.commentaire ? `<p style=\"margin:0 0 12px;white-space:pre-wrap\">\ud83d\udcac ${esc(s.commentaire)}</p>` : '<p class=\"sport-mute\" style=\"margin-top:0\">Pas de commentaire.</p>'}\n      ${conseils(s).map(c => `<p style=\"margin:8px 0\">${c}</p>`).join('')}</div>\n      <button class=\"sport-btn danger small\" data-del=\"${esc(s.id)}\" style=\"margin-top:20px\">Supprimer cette s\u00e9ance</button>`;\n    openSheet(h);\n  }\n\n  function openSheet(html) {\n    const sh = $('#sport-sheet'); const was = !sh.classList.contains('hidden');\n    sh.innerHTML = html; sh.classList.remove('hidden', 'closing'); sh.scrollTop = 0;\n    if (!was) { sh.style.animation = 'none'; void sh.offsetWidth; sh.style.animation = ''; }\n    document.body.classList.add('sheet-open');\n  }\n  function closeSheet() {\n    const sh = $('#sport-sheet'); if (sh.classList.contains('hidden')) return;\n    document.body.classList.remove('sheet-open');\n    sh.classList.add('closing');\n    setTimeout(() => { sh.classList.add('hidden'); sh.classList.remove('closing'); }, 290);\n  }\n\n  /* =====================================================================\n     D\u00c9MARRER LA S\u00c9ANCE\n     ===================================================================== */\n  function renderStart() {\n    const el = $('#sport-pg-start');\n    const run = store.get('sportRun');\n    const p = nextProgramme();\n    let h = `<h1>S\u00e9ance du jour</h1>`;\n    if (run) {\n      h += `<div class=\"sport-go-wrap\"><button class=\"sport-go\" id=\"sport-resume\" style=\"font-size:30px\">REPRENDRE</button>\n        <div class=\"sport-today\"><div class=\"sport-big\">${esc(run.thematique)}</div><div class=\"sport-mute\">S\u00e9ance en cours \u00b7 exercice ${run.exIdx + 1}/${run.exos.length}</div></div>\n        <button class=\"sport-choose\" id=\"sport-abandon-start\">Abandonner cette s\u00e9ance</button></div>`;\n    } else if (!p) {\n      h += `<div class=\"sport-card sport-empty\">Cr\u00e9e d'abord une s\u00e9ance dans l'onglet Programme.</div>`;\n    } else {\n      h += `<div class=\"sport-go-wrap\"><button class=\"sport-go\" id=\"sport-go\">GO</button>\n        <div class=\"sport-today\"><div class=\"sport-big\">${esc(p.nom)}</div>\n        <div class=\"sport-mute\">${p.type === 'longue' ? 'Longue \u00b7 1h15\u20131h35' : 'Rapide \u00b7 \u224845 min'} \u00b7 ${p.exos.length} exercices</div></div>\n        <button class=\"sport-choose\" id=\"sport-pick\">Choisir ma s\u00e9ance</button></div>`;\n    }\n    el.innerHTML = h;\n  }\n\n  function openPicker() {\n    let h = `<button class=\"sport-back\" data-close>\u2039 Retour</button><h1>Choisir ma s\u00e9ance</h1><p class=\"sport-sub\">Reps et poids pr\u00e9-remplis avec ta derni\u00e8re fois.</p>`;\n    X.progs.forEach(p => {\n      h += `<button class=\"sport-card sport-seance\" data-start=\"${esc(p.id)}\" style=\"display:block!important\">\n        <div class=\"sport-row sport-between\"><span class=\"t\">${esc(p.nom)}</span><span class=\"sport-badge\">${p.type === 'longue' ? 'Longue' : 'Rapide'}</span></div>\n        ${p.exos.map(e => { const l = lastPerf(e.exercice); return `<div class=\"sport-row sport-between\" style=\"margin-top:6px\"><span>${esc(e.exercice)}</span><span class=\"sport-mute\">${l ? seriesSummary(l.series) : `${e.series}\u00d7${e.reps} @ ${fmtKg(num(e.poids))} kg`}</span></div>`; }).join('')}\n        ${strip(p.exos.map(e => e.exercice))}</button>`;\n    });\n    openSheet(h);\n  }\n\n  /* ---------- Moteur de s\u00e9ance ---------- */\n  let run = null, tick = null, wakeLock = null;\n  const save = () => store.set('sportRun', run);\n  const now = () => Date.now();\n  const elapsed = () => run ? now() - run.startedAt - run.pausedTotal - (run.pauseStart ? now() - run.pauseStart : 0) : 0;\n\n  function startRun(progId) {\n    const p = X.progs.find(x => x.id === progId);\n    if (!p || !p.exos.length) { toast('Cette s\u00e9ance ne contient aucun exercice.', true); return; }\n    const muscles = new Set();\n    run = {\n      programme_id: p.id, thematique: p.thematique || p.nom, type: p.type,\n      startedAt: now(), pausedTotal: 0, pauseStart: null, exIdx: 0, phase: 'work', restEnd: null, restDur: 0,\n      exos: p.exos.map(pe => {\n        const ex = X.exByName[pe.exercice] || {};\n        splitM(ex.muscles).forEach(m => muscles.add(m));\n        const last = lastPerf(pe.exercice);\n        const series = last ? last.series.map(s => ({ reps: s.reps, poids: s.poids }))\n          : Array.from({ length: Math.max(1, num(pe.series)) }, () => ({ reps: num(pe.reps), poids: num(pe.poids) }));\n        return { nom: pe.exercice, repos: num(pe.repos_s) || num(D.reglages.repos_defaut) || 90, target: last ? last.ua : null, lastTxt: last ? seriesSummary(last.series) : null, series };\n      })\n    };\n    run.muscles = [...muscles].join(',');\n    save();\n    closeSheet();\n    playLaunch().then(() => openRun(true));\n  }\n\n  function playLaunch() {\n    return new Promise(res => {\n      const l = $('#sport-launch');\n      l.innerHTML = LOGO; l.classList.remove('hidden', 'out');\n      try { navigator.vibrate && navigator.vibrate([20, 60, 40]); } catch (e) { }\n      setTimeout(() => { l.classList.add('out'); res(); }, 1500);\n      setTimeout(() => { l.classList.add('hidden'); l.innerHTML = ''; }, 1900);\n    });\n  }\n\n  async function keepAwake() { try { if ('wakeLock' in navigator) wakeLock = await navigator.wakeLock.request('screen'); } catch (e) { } }\n\n  function openRun(intro) {\n    $('#sport-run').classList.remove('hidden');\n    const clock = $('#sport-clock');\n    clock.classList.remove('hidden');\n    if (intro) {\n      clock.classList.add('intro');\n      renderRun(true);\n      setTimeout(() => { clock.classList.remove('intro'); const b = $('.sport-runbody'); if (b) b.classList.remove('wait'); }, 1400);\n    } else renderRun(false);\n    keepAwake();\n    clearInterval(tick);\n    tick = setInterval(onTick, 250);\n    onTick();\n  }\n\n  function closeRun() {\n    clearInterval(tick);\n    $('#sport-run').classList.add('hidden');\n    $('#sport-clock').classList.add('hidden');\n    try { wakeLock && wakeLock.release(); } catch (e) { }\n  }\n\n  function exUA(ex) { return ex.series.reduce((a, s) => a + uaOf(ex.nom, s.reps, s.poids), 0); }\n\n  function uaTable(ex, k) {\n    return `<table class=\"sport-ua\" data-table=\"${k}\"><tr><th>S\u00e9rie</th><th>Reps</th><th>Poids (kg)</th><th>UA</th></tr>\n      ${ex.series.map((s, i) => `<tr><td>${i + 1}</td>\n        <td><span class=\"sport-step\"><button data-step=\"${k},${i},reps,-1\">\u2212</button><input inputmode=\"numeric\" data-in=\"${k},${i},reps\" value=\"${s.reps}\"><button data-step=\"${k},${i},reps,1\">+</button></span></td>\n        <td><span class=\"sport-step\"><button data-step=\"${k},${i},poids,-2.5\">\u2212</button><input inputmode=\"decimal\" data-in=\"${k},${i},poids\" value=\"${fmtKg(s.poids)}\"><button data-step=\"${k},${i},poids,2.5\">+</button></span></td>\n        <td data-ua=\"${k},${i}\">${fmt(uaOf(ex.nom, s.reps, s.poids))}</td></tr>`).join('')}\n      <tr class=\"total\"><td colspan=\"3\" style=\"text-align:left\">Total</td><td data-uatot=\"${k}\">${fmt(exUA(ex))}</td></tr></table>\n      <div class=\"sport-row\" style=\"margin-top:8px\"><button class=\"sport-btn small\" data-addset=\"${k}\" style=\"flex:1\">+ S\u00e9rie</button><button class=\"sport-btn small\" data-rmset=\"${k}\" style=\"flex:1\">\u2212 S\u00e9rie</button></div>`;\n  }\n\n  function targetBlock(ex, k) {\n    const ua = exUA(ex);\n    if (ex.target == null) return `<div class=\"sport-card\" data-target=\"${k}\"><div class=\"sport-row sport-between\"><span class=\"sport-mute\">Premi\u00e8re fois sur cet exercice</span><b>${fmt(ua)} UA</b></div></div>`;\n    const p = Math.min(100, Math.round(ua / ex.target * 100));\n    return `<div class=\"sport-card\" data-target=\"${k}\"><div class=\"sport-row sport-between\"><span class=\"sport-mute\">Objectif : \u2265 ${fmt(ex.target)} UA</span><b class=\"${ua >= ex.target ? 'up' : 'down'}\">${fmt(ua)} UA</b></div>\n      <div class=\"sport-gauge\"><div style=\"width:${p}%;background:${ua >= ex.target ? 'var(--sport-accent)' : 'var(--sport-amber)'}\"></div></div>\n      <div class=\"sport-mute\" style=\"margin-top:6px\">Derni\u00e8re fois : ${esc(ex.lastTxt)}</div></div>`;\n  }\n\n  function renderRun(wait) {\n    const el = $('#sport-run');\n    const n = run.exos.length;\n    let h = `<div class=\"sport-runbar\"><span class=\"sport-mute\" style=\"font-weight:600\">${run.phase === 'end' ? 'Fin' : `Exo ${run.exIdx + 1}/${n}`}</span><span></span>\n      <button class=\"sport-pausebtn\" id=\"sport-pause\" aria-label=\"Pause\">\u275a\u275a</button></div><div class=\"sport-runbody ${wait ? 'wait' : ''}\">`;\n\n    if (run.phase === 'work') {\n      const k = run.exIdx, ex = run.exos[k], info = X.exByName[ex.nom] || {};\n      const isLast = k === n - 1;\n      h += `<div class=\"sport-visual\">${info.image_url ? `<img src=\"${esc(info.image_url)}\" alt=\"\">` : ''}${bodyMap(info.muscles)}</div>\n        <h1 style=\"margin-top:14px\">${esc(ex.nom)}</h1>\n        <div class=\"sport-row sport-wrap\">${splitM(info.muscles).map(m => `<span class=\"sport-chip red\">${esc(MUSCLES[m] || m)}</span>`).join('')}</div>\n        ${info.consigne ? `<p class=\"sport-mute\" style=\"font-size:14px;margin-top:4px\">${esc(info.consigne)}</p>` : ''}\n        ${targetBlock(ex, k)}\n        <div class=\"sport-card\">${uaTable(ex, k)}</div>\n        <div class=\"sport-fixedcta\"><button class=\"sport-btn primary sport-finish\" id=\"${isLast ? 'sport-endbtn' : 'sport-done'}\">${isLast ? 'FIN DE S\u00c9ANCE' : 'Finis !'}</button></div>`;\n    } else if (run.phase === 'rest') {\n      const k = run.exIdx, ex = run.exos[k], next = run.exos[k + 1];\n      h += `<div class=\"sport-rest\"><div class=\"sport-mute\" style=\"font-weight:600;letter-spacing:1px\">TEMPS DE PAUSE</div>\n          <div class=\"cd\" id=\"sport-cd\">${mmss(run.restDur * 1000)}</div>\n          <div class=\"sport-row\" style=\"justify-content:center;margin:6px 0 14px\"><button class=\"sport-chip\" data-rest=\"-15\">\u221215 s</button><button class=\"sport-chip\" data-rest=\"15\">+15 s</button></div></div>\n        <div class=\"sport-card\"><h3>${esc(ex.nom)} \u2014 ce que tu as vraiment fait</h3>${uaTable(ex, k)}</div>\n        ${targetBlock(ex, k)}\n        ${next ? `<div class=\"sport-card\"><span class=\"sport-mute\">\u00c0 suivre</span><div style=\"font-weight:700;font-size:17px\">${esc(next.nom)}</div><div class=\"sport-mute\">${next.lastTxt ? 'Derni\u00e8re fois : ' + esc(next.lastTxt) : seriesSummary(next.series)}</div></div>` : ''}\n        <div class=\"sport-fixedcta\"><button class=\"sport-btn primary sport-finish\" id=\"sport-next\">Reprendre</button></div>`;\n    } else if (run.phase === 'end') {\n      const total = run.exos.reduce((a, e) => a + exUA(e), 0);\n      h += `<h1>S\u00e9ance termin\u00e9e \ud83d\udcaa</h1><p class=\"sport-sub\">${esc(run.thematique)} \u00b7 ${Math.round(elapsed() / 60000)} min</p>\n        <div class=\"sport-card\" style=\"text-align:center\"><span class=\"sport-mute\">UA totale</span><div class=\"sport-big\">${fmt(total)}</div></div>\n        <div class=\"sport-card\">${run.exos.map(e => { const u = exUA(e); return `<div class=\"sport-row sport-between\" style=\"margin:6px 0\"><span>${esc(e.nom)}</span><b class=\"${trendClass(u, e.target)}\">${fmt(u)}${e.target != null ? ` <span class=\"sport-mute\">/ ${fmt(e.target)}</span>` : ''}</b></div>`; }).join('')}</div>\n        <label class=\"sport-lbl\">Seul ou accompagn\u00e9 ?</label>\n        <div class=\"sport-seg\" id=\"sport-acc\"><button data-acc=\"0\" class=\"${run.accompagne ? '' : 'on'}\">\ud83e\uddcd Seul</button><button data-acc=\"1\" class=\"${run.accompagne ? 'on' : ''}\">\ud83d\udc65 Accompagn\u00e9</button></div>\n        <label class=\"sport-lbl\">Atteinte de mes objectifs : <b id=\"sport-notev\">${run.note == null ? 7 : run.note}</b>/10</label>\n        <input type=\"range\" min=\"0\" max=\"10\" step=\"1\" id=\"sport-note\" value=\"${run.note == null ? 7 : run.note}\">\n        <label class=\"sport-lbl\">Commentaire</label>\n        <textarea id=\"sport-com\" rows=\"4\" placeholder=\"Sensations, douleurs, ce que tu veux changer\u2026\">${esc(run.commentaire || '')}</textarea>\n        <div class=\"sport-fixedcta\"><button class=\"sport-btn primary sport-finish\" id=\"sport-save\">Enregistrer la s\u00e9ance</button>\n        <button class=\"sport-btn small\" id=\"sport-backlast\" style=\"margin-top:8px\">\u2039 Revenir au dernier exercice</button></div>`;\n    }\n    h += `</div>`;\n    if (run.pauseStart) h += `<div class=\"sport-pause-ov\"><div class=\"sport-big\">S\u00e9ance en pause</div><div class=\"sport-mute\">Le chrono et le minuteur sont arr\u00eat\u00e9s.</div>\n      <button class=\"sport-btn primary sport-finish\" id=\"sport-unpause\" style=\"max-width:320px\">Reprendre</button>\n      <button class=\"sport-btn danger small\" id=\"sport-abandon\" style=\"max-width:320px\">Abandonner la s\u00e9ance</button></div>`;\n    el.innerHTML = h;\n    el.scrollTop = 0;\n    $('#sport-clock').classList.toggle('paused', !!run.pauseStart);\n  }\n\n  let beeped = false;\n  function onTick() {\n    if (!run) return;\n    $('#sport-clock').textContent = mmss(elapsed());\n    if (run.phase === 'rest' && !run.pauseStart) {\n      const left = run.restEnd - now();\n      const cd = $('#sport-cd');\n      if (cd) { cd.textContent = left >= 0 ? mmss(left + 999) : '+' + mmss(-left); cd.classList.toggle('over', left < 0); }\n      if (left <= 0 && !beeped) { beeped = true; alertEnd(); }\n    }\n  }\n  function alertEnd() {\n    try { navigator.vibrate && navigator.vibrate([300, 120, 300]); } catch (e) { }\n    try {\n      const ctx = new (window.AudioContext || window.webkitAudioContext)();\n      [0, .25].forEach(t => { const o = ctx.createOscillator(), g = ctx.createGain(); o.frequency.value = 880; o.connect(g); g.connect(ctx.destination);\n        g.gain.setValueAtTime(.2, ctx.currentTime + t); g.gain.exponentialRampToValueAtTime(.001, ctx.currentTime + t + .2); o.start(ctx.currentTime + t); o.stop(ctx.currentTime + t + .22); });\n    } catch (e) { }\n  }\n\n  function refreshUA(k) {\n    const ex = run.exos[k];\n    ex.series.forEach((s, i) => document.querySelectorAll(`[data-ua=\"${k},${i}\"]`).forEach(td => td.textContent = fmt(uaOf(ex.nom, s.reps, s.poids))));\n    document.querySelectorAll(`[data-uatot=\"${k}\"]`).forEach(td => td.textContent = fmt(exUA(ex)));\n    const tb = document.querySelector(`[data-target=\"${k}\"]`);\n    if (tb) tb.outerHTML = targetBlock(ex, k);\n    save();\n  }\n\n  function runClick(e) {\n    const t = e.target.closest('button');\n    if (!t || !run) return;\n    if (t.id === 'sport-pause') { run.pauseStart = now(); save(); renderRun(); return; }\n    if (t.id === 'sport-unpause') {\n      const d = now() - run.pauseStart;\n      run.pausedTotal += d; if (run.restEnd) run.restEnd += d; run.pauseStart = null; save(); renderRun(); onTick(); return;\n    }\n    if (t.id === 'sport-abandon') {\n      if (t.dataset.sure) { store.del('sportRun'); run = null; closeRun(); renderStart(); toast('S\u00e9ance abandonn\u00e9e'); return; }\n      t.dataset.sure = 1; t.textContent = 'Appuie encore pour confirmer'; return;\n    }\n    if (t.dataset.step) {\n      const [k, i, f, d] = t.dataset.step.split(',');\n      const s = run.exos[k].series[i];\n      s[f] = Math.max(0, Math.round((num(s[f]) + num(d)) * 10) / 10);\n      const inp = document.querySelector(`[data-in=\"${k},${i},${f}\"]`); if (inp) inp.value = f === 'poids' ? fmtKg(s[f]) : s[f];\n      refreshUA(+k); return;\n    }\n    if (t.dataset.addset) { const ex = run.exos[t.dataset.addset]; const l = ex.series[ex.series.length - 1] || { reps: 10, poids: 0 }; ex.series.push({ ...l }); save(); renderRun(); return; }\n    if (t.dataset.rmset) { const ex = run.exos[t.dataset.rmset]; if (ex.series.length > 1) ex.series.pop(); save(); renderRun(); return; }\n    if (t.id === 'sport-done') {\n      const ex = run.exos[run.exIdx];\n      run.phase = 'rest'; run.restDur = ex.repos; run.restEnd = now() + ex.repos * 1000; beeped = false; save(); renderRun(); onTick(); return;\n    }\n    if (t.dataset.rest) { run.restEnd += num(t.dataset.rest) * 1000; run.restDur = Math.max(0, run.restDur + num(t.dataset.rest)); if (run.restEnd > now()) beeped = false; save(); onTick(); return; }\n    if (t.id === 'sport-next') { run.exIdx++; run.phase = 'work'; run.restEnd = null; save(); renderRun(); return; }\n    if (t.id === 'sport-endbtn') { run.phase = 'end'; save(); renderRun(); return; }\n    if (t.id === 'sport-backlast') { run.phase = 'work'; save(); renderRun(); return; }\n    if (t.dataset.acc) { run.accompagne = t.dataset.acc === '1'; save(); document.querySelectorAll('[data-acc]').forEach(b => b.classList.toggle('on', b === t)); return; }\n    if (t.id === 'sport-save') return finishRun(t);\n  }\n\n  async function finishRun(btn) {\n    btn.disabled = true; btn.textContent = 'Enregistrement\u2026';\n    const payload = {\n      programme_id: run.programme_id, thematique: run.thematique, type: run.type, accompagne: !!run.accompagne,\n      duree_min: Math.round(elapsed() / 60000), note: run.note == null ? 7 : run.note, commentaire: run.commentaire || '', muscles: run.muscles,\n      exos: run.exos.map(e => ({ nom: e.nom, series: e.series.map(s => ({ reps: num(s.reps), poids: num(s.poids), ua: uaOf(e.nom, s.reps, s.poids) })) }))\n    };\n    try {\n      const id = await api('saveSeance', payload);\n      store.del('sportRun'); run = null; closeRun();\n      await reload();\n      goPage(1, false);\n      toast('S\u00e9ance enregistr\u00e9e \u2705');\n      openSeance(id);\n    } catch (e) { btn.disabled = false; btn.textContent = 'R\u00e9essayer l\\'enregistrement'; }\n  }\n\n  function runInput(e) {\n    const t = e.target;\n    if (!run) return;\n    if (t.dataset.in) { const [k, i, f] = t.dataset.in.split(','); run.exos[k].series[i][f] = num(t.value); refreshUA(+k); }\n    if (t.id === 'sport-note') { run.note = +t.value; $('#sport-notev').textContent = t.value; save(); }\n    if (t.id === 'sport-com') { run.commentaire = t.value; save(); }\n  }\n\n  /* =====================================================================\n     PROGRAMME\n     ===================================================================== */\n  function renderProg() {\n    const el = $('#sport-pg-prog');\n    let h = `<h1>Programme</h1><p class=\"sport-sub\">L'ordre d\u00e9finit la rotation du bouton GO.</p><h2>Mes s\u00e9ances</h2>`;\n    X.progs.forEach(p => {\n      const muscles = new Set(); p.exos.forEach(e => splitM((X.exByName[e.exercice] || {}).muscles).forEach(m => muscles.add(m)));\n      h += `<button class=\"sport-card sport-seance\" data-editprog=\"${esc(p.id)}\" style=\"display:block!important\">\n        <div class=\"sport-row sport-between\"><span class=\"t\">${num(p.ordre)}. ${esc(p.nom)}</span><span class=\"sport-badge\">${p.type === 'longue' ? 'Longue 1h15\u20131h35' : 'Rapide 45 min'}</span></div>\n        <div class=\"sport-mute\" style=\"margin:4px 0 8px\">${p.exos.map(e => `${esc(e.exercice)} (${e.series}\u00d7${e.reps})`).join(' \u00b7 ')}</div>\n        <div class=\"sport-row sport-wrap\">${[...muscles].map(m => `<span class=\"sport-chip\">${esc(MUSCLES[m] || m)}</span>`).join('')}</div>${strip(p.exos.map(e => e.exercice))}</button>`;\n    });\n    h += `<button class=\"sport-btn primary\" data-editprog=\"\">+ Nouvelle s\u00e9ance</button>\n      <h2 style=\"margin-top:30px\">Biblioth\u00e8que d'exercices</h2><p class=\"sport-sub\">Rang\u00e9s par groupe musculaire. Touche un exercice pour le modifier ou ajouter une photo.</p>`;\n    const byGroup = {};\n    D.exercices.forEach(e => { const g = groupOf(e); (byGroup[g] = byGroup[g] || []).push(e); });\n    [...GROUPS.map(g => g[0]), 'Autres'].forEach(g => {\n      const list = (byGroup[g] || []).sort((a, b) => a.nom.localeCompare(b.nom));\n      if (g === 'Autres' && !list.length) return;\n      const firstMuscle = (GROUPS.find(x => x[0] === g) || [0, ['']])[1][0];\n      h += `<div class=\"sport-group\"><h3>${g}<span class=\"n\">${list.length} exercice${list.length > 1 ? 's' : ''}</span></h3>\n        <button class=\"sport-libadd\" data-newex=\"${firstMuscle}\" aria-label=\"Ajouter un exercice ${g}\">+</button></div><div class=\"sport-card\" style=\"padding:6px\">`;\n      if (!list.length) h += `<div class=\"sport-mute\" style=\"padding:10px\">Aucun exercice pour l'instant.</div>`;\n      list.forEach(e => {\n        h += `<button class=\"sport-exitem\" data-editex=\"${esc(e.nom)}\">${thumb([e.nom])}<span><b>${esc(e.nom)}</b><span class=\"sport-mute\">${splitM(e.muscles).map(m => MUSCLES[m] || m).join(', ')}</span></span><span class=\"sport-mute\">\u203a</span></button>`;\n      });\n      h += `</div>`;\n    });\n    h += `<button class=\"sport-btn small\" data-editex=\"\" style=\"margin-top:14px\">+ Nouvel exercice</button>\n      <h2>R\u00e9glages</h2><div class=\"sport-card\">\n      <label class=\"sport-lbl\" style=\"margin-top:0\">Poids de corps (kg) \u2014 ajout\u00e9 au lest pour les exercices au poids du corps</label>\n      <input id=\"sport-bw\" inputmode=\"decimal\" value=\"${esc(D.reglages.poids_de_corps)}\" placeholder=\"ex. 72\">\n      <label class=\"sport-lbl\">Repos par d\u00e9faut (secondes)</label>\n      <input id=\"sport-rd\" inputmode=\"numeric\" value=\"${esc(D.reglages.repos_defaut || 90)}\">\n      <label class=\"sport-lbl\">Agenda : mots-cl\u00e9s des s\u00e9ances de salle (s\u00e9par\u00e9s par des virgules)</label>\n      <textarea id=\"sport-ms\" rows=\"2\">${esc(D.reglages.mots_seance || DEF_SEANCE)}</textarea>\n      <label class=\"sport-lbl\">Agenda : mots-cl\u00e9s des autres sports</label>\n      <textarea id=\"sport-mp\" rows=\"3\">${esc(D.reglages.mots_sport || DEF_SPORT)}</textarea>\n      <label class=\"sport-lbl\">Agenda \u00e0 lire (adresse Gmail, vide = agenda principal du compte)</label>\n      <input id=\"sport-ag\" value=\"${esc(D.reglages.agenda_id || '')}\" placeholder=\"toi@gmail.com\">\n      <label class=\"sport-lbl\">Photo de fond (lien d'image, laisse vide pour la photo par d\u00e9faut)</label>\n      <input id=\"sport-fd\" value=\"${esc(D.reglages.fond_url || '')}\" placeholder=\"https://\u2026\">\n      <button class=\"sport-btn small primary\" id=\"sport-savereg\" style=\"margin-top:12px\">Enregistrer les r\u00e9glages</button>\n      <div class=\"sport-mute\" style=\"margin-top:14px;font-size:12px;line-height:1.6\">Compte : <b>${esc((D.info || {}).compte || '?')}</b><br>\n      Google Sheet : <b>${esc((D.info || {}).sheet || '?')}</b><br>Agenda : <b>${esc(D.reglages.agenda_id || 'agenda principal du compte')}</b></div></div>`;\n    el.innerHTML = h;\n  }\n\n  let editP = null;\n  function openProgEditor(id) {\n    const p = X.progs.find(x => x.id === id);\n    editP = p ? { id: p.id, nom: p.nom, thematique: p.thematique, type: p.type || 'rapide', ordre: p.ordre, exos: p.exos.map(e => ({ ...e })) }\n      : { id: '', nom: '', thematique: '', type: 'rapide', ordre: X.progs.length + 1, exos: [] };\n    renderProgEditor();\n  }\n  function renderProgEditor() {\n    const opts = sel => D.exercices.slice().sort((a, b) => a.nom.localeCompare(b.nom)).map(e => `<option ${e.nom === sel ? 'selected' : ''}>${esc(e.nom)}</option>`).join('');\n    let h = `<button class=\"sport-back\" data-close>\u2039 Retour</button><h1>${editP.id ? 'Modifier la s\u00e9ance' : 'Nouvelle s\u00e9ance'}</h1>\n      <label class=\"sport-lbl\">Nom</label><input data-pf=\"nom\" value=\"${esc(editP.nom)}\" placeholder=\"ex. Pecs + Triceps\">\n      <label class=\"sport-lbl\">Th\u00e9matique (groupes musculaires)</label><input data-pf=\"thematique\" value=\"${esc(editP.thematique)}\" placeholder=\"ex. Pecs + Triceps\">\n      <label class=\"sport-lbl\">Type</label>\n      <div class=\"sport-seg\"><button data-ptype=\"rapide\" class=\"${editP.type !== 'longue' ? 'on' : ''}\">Rapide (45 min)</button><button data-ptype=\"longue\" class=\"${editP.type === 'longue' ? 'on' : ''}\">Longue (1h15\u20131h35)</button></div>\n      <label class=\"sport-lbl\">Position dans la rotation GO</label><input data-pf=\"ordre\" inputmode=\"numeric\" value=\"${esc(editP.ordre)}\">\n      <h2>Exercices</h2>`;\n    editP.exos.forEach((e, i) => {\n      h += `<div class=\"sport-card\"><div class=\"sport-exrow\"><select data-pe=\"${i},exercice\">${opts(e.exercice)}</select>\n        <span class=\"sport-row sport-icons\"><button data-pmove=\"${i},-1\">\u2191</button><button data-pmove=\"${i},1\">\u2193</button><button data-prm=\"${i}\">\u2715</button></span></div>\n        <div class=\"sport-mini\"><div><label>S\u00e9ries</label><input inputmode=\"numeric\" data-pe=\"${i},series\" value=\"${esc(e.series)}\"></div>\n        <div><label>Reps</label><input inputmode=\"numeric\" data-pe=\"${i},reps\" value=\"${esc(e.reps)}\"></div>\n        <div><label>Poids kg</label><input inputmode=\"decimal\" data-pe=\"${i},poids\" value=\"${esc(e.poids)}\"></div>\n        <div><label>Repos s</label><input inputmode=\"numeric\" data-pe=\"${i},repos_s\" value=\"${esc(e.repos_s)}\"></div></div></div>`;\n    });\n    h += `<button class=\"sport-btn small\" id=\"sport-padd\">+ Ajouter un exercice</button>\n      <button class=\"sport-btn primary\" id=\"sport-psave\" style=\"margin-top:18px\">Enregistrer</button>\n      ${editP.id ? `<button class=\"sport-btn danger small\" id=\"sport-pdel\" style=\"margin-top:10px\">Supprimer cette s\u00e9ance</button>` : ''}`;\n    openSheet(h);\n  }\n\n  let editE = null;\n  const imgPrev = () => editE.image_url ? `<div class=\"prev\" style=\"background-image:url('${esc(editE.image_url)}')\"></div>` : `<div class=\"prev empty\">Pas encore d'image</div>`;\n  /** R\u00e9duit une photo pour qu'elle tienne dans une cellule du Sheet (\u2248 45 000 caract\u00e8res max). */\n  function fileToDataUrl(file) {\n    return new Promise((res, rej) => {\n      if (file.type === 'image/gif' && file.size < 33000) { const r = new FileReader(); r.onload = () => res(r.result); r.onerror = rej; r.readAsDataURL(file); return; }\n      const url = URL.createObjectURL(file), im = new Image();\n      im.onload = () => {\n        let size = 480, q = 0.74, out = '';\n        for (let k = 0; k < 10; k++) {\n          const sc = Math.min(1, size / Math.max(im.width, im.height));\n          const c = document.createElement('canvas'); c.width = Math.round(im.width * sc); c.height = Math.round(im.height * sc);\n          const g = c.getContext('2d'); g.fillStyle = '#fff'; g.fillRect(0, 0, c.width, c.height); g.drawImage(im, 0, 0, c.width, c.height);\n          out = c.toDataURL('image/jpeg', q);\n          if (out.length < 45000) break;\n          size *= 0.82; q = Math.max(0.45, q - 0.06);\n        }\n        URL.revokeObjectURL(url); res(out);\n      };\n      im.onerror = () => rej(new Error('Image illisible'));\n      im.src = url;\n    });\n  }\n  function openExEditor(nom, muscle) {\n    const e = D.exercices.find(x => x.nom === nom);\n    editE = e ? { ...e, ancien_nom: e.nom, muscles: splitM(e.muscles) } : { nom: '', muscles: muscle ? [muscle] : [], type_charge: 'charge', consigne: '', image_url: '' };\n    renderExEditor();\n  }\n  function renderExEditor() {\n    const h = `<button class=\"sport-back\" data-close>\u2039 Retour</button><h1>${editE.ancien_nom ? 'Modifier l\\'exercice' : 'Nouvel exercice'}</h1>\n      <label class=\"sport-lbl\">Nom</label><input data-ef=\"nom\" value=\"${esc(editE.nom)}\">\n      <label class=\"sport-lbl\">Muscles cibl\u00e9s</label>\n      <div class=\"sport-visual\" id=\"sport-exmap\">${bodyMap(editE.muscles)}</div>\n      <div class=\"sport-row sport-wrap\" style=\"margin-top:10px\">${Object.keys(MUSCLES).map(m => `<button class=\"sport-chip ${editE.muscles.includes(m) ? 'red' : ''}\" data-emus=\"${m}\">${MUSCLES[m]}</button>`).join('')}</div>\n      <label class=\"sport-lbl\">Type de charge</label>\n      <div class=\"sport-seg\"><button data-etype=\"charge\" class=\"${editE.type_charge !== 'poids_du_corps' ? 'on' : ''}\">Charge</button><button data-etype=\"poids_du_corps\" class=\"${editE.type_charge === 'poids_du_corps' ? 'on' : ''}\">Poids du corps (+ lest)</button></div>\n      <label class=\"sport-lbl\">Consigne (affich\u00e9e pendant la s\u00e9ance)</label><textarea data-ef=\"consigne\" rows=\"3\">${esc(editE.consigne)}</textarea>\n      <label class=\"sport-lbl\">Image de l'exercice</label>\n      <div class=\"sport-imgbox\"><div id=\"sport-imgprev\">${imgPrev()}</div>\n        <div><button class=\"sport-btn small primary\" id=\"sport-imgpick\">\ud83d\udcf7 Ajouter une photo</button>\n        <button class=\"sport-btn small\" id=\"sport-imgclear\">Retirer l'image</button></div></div>\n      <input type=\"file\" id=\"sport-imgfile\" accept=\"image/*\" class=\"hidden\">\n      <label class=\"sport-lbl\">\u2026ou colle le lien d'une image ou d'un GIF</label><input data-ef=\"image_url\" id=\"sport-imgurl\" value=\"${editE.image_url && editE.image_url.startsWith('data:') ? '' : esc(editE.image_url)}\" placeholder=\"https://\u2026\">\n      <button class=\"sport-btn primary\" id=\"sport-esave\" style=\"margin-top:18px\">Enregistrer</button>\n      ${editE.ancien_nom ? `<button class=\"sport-btn danger small\" id=\"sport-edel\" style=\"margin-top:10px\">Supprimer cet exercice</button>` : ''}`;\n    openSheet(h);\n  }\n\n  /* ---------- Clics dans les panneaux ---------- */\n  async function sheetClick(e) {\n    const t = e.target.closest('button');\n    if (!t) return;\n    if (t.hasAttribute('data-close')) return closeSheet();\n    if (t.dataset.start) return startRun(t.dataset.start);\n    if (t.dataset.del) {\n      if (!t.dataset.sure) { t.dataset.sure = 1; t.textContent = 'Appuie encore pour confirmer'; return; }\n      await api('deleteSeance', t.dataset.del); closeSheet(); await reload(); toast('S\u00e9ance supprim\u00e9e'); return;\n    }\n    // \u00e9diteur de programme\n    if (t.dataset.ptype) { editP.type = t.dataset.ptype; return renderProgEditor(); }\n    if (t.dataset.pmove) { const [i, d] = t.dataset.pmove.split(',').map(Number); const j = i + d; if (j < 0 || j >= editP.exos.length) return; [editP.exos[i], editP.exos[j]] = [editP.exos[j], editP.exos[i]]; return renderProgEditor(); }\n    if (t.dataset.prm) { editP.exos.splice(+t.dataset.prm, 1); return renderProgEditor(); }\n    if (t.id === 'sport-padd') { editP.exos.push({ exercice: (D.exercices[0] || {}).nom || '', series: 4, reps: 12, poids: 0, repos_s: num(D.reglages.repos_defaut) || 90 }); return renderProgEditor(); }\n    if (t.id === 'sport-psave') {\n      if (!editP.nom) return toast('Donne un nom \u00e0 la s\u00e9ance', true);\n      t.disabled = true; await api('saveProgramme', { ...editP, thematique: editP.thematique || editP.nom }); closeSheet(); await reload(); toast('S\u00e9ance enregistr\u00e9e'); return;\n    }\n    if (t.id === 'sport-pdel') {\n      if (!t.dataset.sure) { t.dataset.sure = 1; t.textContent = 'Appuie encore pour confirmer'; return; }\n      await api('deleteProgramme', editP.id); closeSheet(); await reload(); toast('S\u00e9ance supprim\u00e9e'); return;\n    }\n    // \u00e9diteur d'exercice\n    if (t.dataset.emus) {\n      const m = t.dataset.emus, i = editE.muscles.indexOf(m);\n      i >= 0 ? editE.muscles.splice(i, 1) : editE.muscles.push(m);\n      t.classList.toggle('red'); $('#sport-exmap').innerHTML = bodyMap(editE.muscles); return;\n    }\n    if (t.dataset.etype) { editE.type_charge = t.dataset.etype; document.querySelectorAll('[data-etype]').forEach(b => b.classList.toggle('on', b === t)); return; }\n    if (t.id === 'sport-imgpick') { $('#sport-imgfile').click(); return; }\n    if (t.id === 'sport-imgclear') { editE.image_url = ''; $('#sport-imgprev').innerHTML = imgPrev(); $('#sport-imgurl').value = ''; return; }\n    if (t.id === 'sport-edel') {\n      if (!t.dataset.sure) { t.dataset.sure = 1; t.textContent = 'Appuie encore pour confirmer'; return; }\n      await api('deleteExercice', editE.ancien_nom); closeSheet(); await reload(); toast('Exercice supprim\u00e9'); return;\n    }\n    if (t.id === 'sport-esave') {\n      if (!editE.nom) return toast('Donne un nom \u00e0 l\\'exercice', true);\n      t.disabled = true; await api('saveExercice', { ...editE, muscles: editE.muscles.join(',') }); closeSheet(); await reload(); toast('Exercice enregistr\u00e9'); return;\n    }\n    if (t.dataset.seance) return openSeance(t.dataset.seance);\n  }\n  function sheetInput(e) {\n    const t = e.target;\n    if (t.dataset.pf) editP[t.dataset.pf] = t.value;\n    if (t.dataset.pe) { const [i, f] = t.dataset.pe.split(','); editP.exos[i][f] = f === 'exercice' ? t.value : num(t.value); }\n    if (t.dataset.ef) { editE[t.dataset.ef] = t.value; if (t.id === 'sport-imgurl') $('#sport-imgprev').innerHTML = imgPrev(); }\n    if (t.id === 'sport-imgfile' && e.type === 'change' && t.files && t.files[0]) {\n      $('#sport-imgprev').innerHTML = '<div class=\"prev empty\">Pr\u00e9paration\u2026</div>';\n      fileToDataUrl(t.files[0]).then(u => { editE.image_url = u; $('#sport-imgprev').innerHTML = imgPrev(); $('#sport-imgurl').value = ''; })\n        .catch(() => { toast('Impossible de lire cette image', true); $('#sport-imgprev').innerHTML = imgPrev(); });\n    }\n  }\n\n  /* ---------- Navigation entre les 3 \u00e9crans (pile de pages) ----------\n     S\u00e9ance (0) est en dessous, Accueil (1) au milieu, Programme (2) au-dessus.\n     Un glissement ne peut amener qu'\u00e0 la page voisine. */\n  let pos = 1, cur = 1, animId = null, drag = null;\n  const pages = () => document.querySelectorAll('.sport-page');\n  function layout() {\n    pages().forEach((pg, i) => {\n      const d = i - pos;\n      if (d >= 0) {\n        pg.style.transform = d ? `translate3d(${(d * 100).toFixed(3)}%,0,0)` : 'translate3d(0,0,0)';\n        pg.style.filter = '';\n        pg.style.visibility = d >= 1 ? 'hidden' : 'visible';\n        pg.classList.toggle('incoming', d > 0.001 && d < 1);\n      } else {\n        const e = Math.max(d, -1);\n        pg.style.transform = `translate3d(${(e * 26).toFixed(3)}%,0,0) scale(${(1 + 0.07 * e).toFixed(4)})`;\n        pg.style.filter = `brightness(${(1 + 0.62 * e).toFixed(3)})`;\n        pg.style.visibility = d <= -1 ? 'hidden' : 'visible';\n        pg.classList.remove('incoming');\n      }\n      pg.style.zIndex = i + 1;\n    });\n    const i = Math.round(pos);\n    document.querySelectorAll('#sport-tabs button').forEach(b => b.classList.toggle('on', +b.dataset.page === i));\n    $('#sport-tabglow').style.transform = `translateX(${(pos * 100).toFixed(1)}%)`;\n    $('#sport-bglogo').style.opacity = (0.08 + 0.24 * Math.max(0, 1 - pos)).toFixed(3);\n  }\n  const ease = t => 1 - Math.pow(1 - t, 3);\n  function animateTo(target, smooth = true) {\n    cancelAnimationFrame(animId);\n    cur = target;\n    if (!smooth) { pos = target; layout(); return; }\n    const from = pos, dist = Math.abs(target - from);\n    if (dist < 0.001) { pos = target; layout(); return; }\n    const dur = 230 + 170 * Math.min(dist, 2), t0 = performance.now();\n    const step = now => {\n      const t = Math.min(1, (now - t0) / dur);\n      pos = from + (target - from) * ease(t); layout();\n      if (t < 1) animId = requestAnimationFrame(step);\n    };\n    animId = requestAnimationFrame(step);\n  }\n  function goPage(i, smooth = true) { animateTo(Math.max(0, Math.min(2, i)), smooth); }\n\n  function dStart(x, y) { cancelAnimationFrame(animId); drag = { x0: x, y0: y, p0: pos, lock: null, pts: [[performance.now(), x]] }; }\n  function dMove(x, y, ev) {\n    if (!drag) return;\n    const dx = x - drag.x0, dy = y - drag.y0;\n    if (!drag.lock) {\n      if (Math.abs(dx) < 7 && Math.abs(dy) < 7) return;\n      drag.lock = Math.abs(dx) > Math.abs(dy) * 1.15 ? 'x' : 'y';\n      if (drag.lock === 'y') { animateTo(cur); return; }\n    }\n    if (drag.lock !== 'x') return;\n    if (ev && ev.cancelable) ev.preventDefault();\n    const W = window.innerWidth || 1;\n    let p = drag.p0 - dx / W;\n    const lo = Math.max(0, cur - 1), hi = Math.min(2, cur + 1);\n    if (p < lo) p = lo - Math.min(0.05, (lo - p) * 0.25);\n    if (p > hi) p = hi + Math.min(0.05, (p - hi) * 0.25);\n    pos = p; layout();\n    drag.pts.push([performance.now(), x]); if (drag.pts.length > 6) drag.pts.shift();\n  }\n  function dEnd() {\n    if (!drag) return;\n    const d = drag; drag = null;\n    if (d.lock !== 'x') return;\n    const a = d.pts[0], b = d.pts[d.pts.length - 1];\n    const v = (b[1] - a[1]) / Math.max(1, b[0] - a[0]); // px/ms, >0 = doigt vers la droite\n    let target = cur;\n    if (pos - cur > 0.2 || v < -0.35) target = cur + 1;\n    else if (cur - pos > 0.2 || v > 0.35) target = cur - 1;\n    target = Math.max(0, Math.min(2, Math.max(cur - 1, Math.min(cur + 1, target))));\n    animateTo(target);\n  }\n  function bindPager() {\n    const el = $('#sport-pager');\n    el.addEventListener('touchstart', e => { if (e.touches.length === 1) dStart(e.touches[0].clientX, e.touches[0].clientY); }, { passive: true });\n    el.addEventListener('touchmove', e => { if (e.touches.length === 1) dMove(e.touches[0].clientX, e.touches[0].clientY, e); }, { passive: false });\n    el.addEventListener('touchend', dEnd); el.addEventListener('touchcancel', dEnd);\n    el.addEventListener('pointerdown', e => { if (e.pointerType === 'mouse') dStart(e.clientX, e.clientY); });\n    window.addEventListener('pointermove', e => { if (e.pointerType === 'mouse' && drag) dMove(e.clientX, e.clientY, e); });\n    window.addEventListener('pointerup', e => { if (e.pointerType === 'mouse') dEnd(); });\n    window.addEventListener('resize', layout);\n  }\n\n  function renderAll() { renderHome(); renderStart(); renderProg(); }\n  async function reload() { D = await api('getData'); indexData(); renderAll(); }\n\n  /* ---------- D\u00e9marrage ---------- */\n  document.addEventListener('DOMContentLoaded', init);\n  if (document.readyState !== 'loading') init();\n  let started = false;\n  async function init() {\n    if (started) return; started = true;\n    $('#sport-bglogo').innerHTML = LOGO;\n    document.addEventListener('pointerdown', e => { if (e.target.closest('button')) try { navigator.vibrate && navigator.vibrate(6); } catch (x) { } }, { passive: true });\n    $('#sport-tabs').addEventListener('click', e => { const b = e.target.closest('button'); if (b) goPage(+b.dataset.page); });\n    bindPager(); layout();\n    $('#sport-pg-home').addEventListener('click', e => {\n      const b = e.target.closest('button'); if (!b) return;\n      if (b.dataset.filter) { homeFilter = b.dataset.filter; renderHome(); }\n      if (b.dataset.wk !== undefined) { const v = +b.dataset.wk; weekOffset = v === 0 ? 0 : weekOffset + v; selDay = null; renderWeek(); }\n      if (b.dataset.day) { selDay = b.dataset.day; renderWeek(); }\n      if (b.dataset.seance) openSeance(b.dataset.seance);\n    });\n    $('#sport-pg-start').addEventListener('click', e => {\n      const b = e.target.closest('button'); if (!b) return;\n      if (b.id === 'sport-go') { const p = nextProgramme(); if (p) startRun(p.id); }\n      if (b.id === 'sport-pick') openPicker();\n      if (b.id === 'sport-resume') { run = store.get('sportRun'); openRun(false); }\n      if (b.id === 'sport-abandon-start') {\n        if (!b.dataset.sure) { b.dataset.sure = 1; b.textContent = 'Appuie encore pour confirmer'; return; }\n        store.del('sportRun'); renderStart(); toast('S\u00e9ance abandonn\u00e9e');\n      }\n    });\n    $('#sport-pg-prog').addEventListener('click', async e => {\n      const b = e.target.closest('button'); if (!b) return;\n      if (b.dataset.editprog !== undefined) openProgEditor(b.dataset.editprog);\n      if (b.dataset.editex !== undefined) openExEditor(b.dataset.editex);\n      if (b.dataset.newex !== undefined) openExEditor('', b.dataset.newex);\n      if (b.id === 'sport-savereg') {\n        b.disabled = true;\n        await api('saveReglages', { poids_de_corps: num($('#sport-bw').value) || '', repos_defaut: num($('#sport-rd').value) || 90,\n          mots_seance: $('#sport-ms').value, mots_sport: $('#sport-mp').value, fond_url: $('#sport-fd').value.trim(), agenda_id: $('#sport-ag').value.trim() });\n        for (const k in agendaCache) delete agendaCache[k];\n        setBackground();\n        await reload(); toast('R\u00e9glages enregistr\u00e9s');\n      }\n    });\n    $('#sport-sheet').addEventListener('click', sheetClick);\n    $('#sport-sheet').addEventListener('input', sheetInput);\n    $('#sport-sheet').addEventListener('change', sheetInput);\n    $('#sport-run').addEventListener('click', runClick);\n    $('#sport-run').addEventListener('input', runInput);\n    document.addEventListener('visibilitychange', () => { if (!document.hidden && run) { keepAwake(); onTick(); } });\n\n    try { await reload(); } catch (e) { $('#sport-loading').innerHTML = '<p>Impossible de charger les donn\u00e9es.<br>Recharge la page.</p>'; return; }\n    $('#sport-loading').classList.add('hidden');\n    setBackground();\n    goPage(1, false);\n    const saved = store.get('sportRun');\n    if (saved) { run = saved; openRun(false); }\n  }\n})();\n</script>\n\n</body>\n</html>\n";
