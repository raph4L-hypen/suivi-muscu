bic-bezier(.2, .8, .2, 1), filter .45s; transform-origin: 50% 40%; }\n  .sport-page { position: absolute; inset: 0; overflow-y: auto; overflow-x: hidden; touch-action: pan-y;\n    padding: 18px 16px 110px; -webkit-overflow-scrolling: touch; overscroll-behavior: contain;\n    will-change: transform; transform-origin: 50% 50%; backface-visibility: hidden; background: rgba(7, 8, 10, .45); }\n  /* page qui arrive : plus sombre, avec une ombre sur son bord gauche */\n  .sport-page.incoming { background: rgba(7, 8, 10, .9); box-shadow: -26px 0 44px rgba(0,0,0,.8), -1px 0 0 rgba(57,255,142,.22); }\n  body.sheet-open #sport-pager { transform: scale(.93) translateX(-4%); filter: brightness(.45) blur(1px); }\n\n  /* Fond : photo de salle flout\u00e9e + logo */\n  #sport-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: #050607; }\n  #sport-bgphoto { position: absolute; inset: -40px; background-size: cover; background-position: center;\n    filter: blur(16px) grayscale(.6) brightness(.38) contrast(1.1); transform: scale(1.08); opacity: 0; transition: opacity 1.2s; }\n  #sport-bgphoto.ok { opacity: 1; }\n  #sport-bgshade { position: absolute; inset: 0;\n    background: radial-gradient(120% 70% at 50% 0%, rgba(57,255,142,.10), transparent 55%),\n                radial-gradient(90% 60% at 50% 110%, rgba(57,255,142,.08), transparent 60%),\n                linear-gradient(180deg, rgba(8,9,11,.35), rgba(8,9,11,.85)); }\n  #sport-bglogo { position: absolute; left: 50%; top: 46%; width: 118vw; max-width: 620px; aspect-ratio: 1;\n    transform: translate(-50%, -50%) rotate(-18deg); opacity: .10; transition: opacity .2s linear; filter: drop-shadow(0 0 30px rgba(57,255,142,.35)); }\n  #sport-bglogo svg { width: 100%; height: 100%; }\n\n  /* Barre de navigation : ic\u00f4nes lumineuses */\n  #sport-tabs { position: fixed; z-index: 30; left: 14px; right: 14px; bottom: calc(12px + env(safe-area-inset-bottom)); height: 64px;\n    display: flex; border-radius: 22px; ba