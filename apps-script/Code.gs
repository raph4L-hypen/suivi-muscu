/**
 * SUIVI MUSCU — Google Apps Script (VERSION UN SEUL FICHIER)
 * Tout est dans ce fichier : supprime les fichiers Index, Styles et App s'ils existent.
 * À coller dans le projet Apps Script lié au Google Sheet "Suivi muscu"
 * (Extensions → Apps Script). Les onglets existants (jambes, DOS, pec triceps)
 * ne sont jamais modifiés : l'appli crée ses propres onglets préfixés "app_".
 */

var SHEETS = {
  Exercices: ['nom', 'muscles', 'type_charge', 'consigne', 'image_url'],
  Programmes: ['id', 'nom', 'thematique', 'type', 'ordre'],
  ProgrammeExercices: ['programme_id', 'ordre', 'exercice', 'series', 'reps', 'poids', 'repos_s'],
  Seances: ['id', 'date', 'programme_id', 'thematique', 'type', 'accompagne', 'duree_min', 'note', 'commentaire', 'muscles', 'ua_totale'],
  Series: ['seance_id', 'date', 'exercice', 'n_serie', 'reps', 'poids', 'ua'],
  Reglages: ['cle', 'valeur']
};
var PREFIX = 'app_';
// Le Google Sheet "Suivi muscu" : l'appli l'ouvre toujours, même si le script a été créé ailleurs.
var SHEET_ID = '16El7XL1WReTc5moKgFVfgl1QNQeRUNxEqbd7sjRt-kU';
function ss_() { return SpreadsheetApp.openById(SHEET_ID); }

/* ---------- Web app ---------- */

function doGet() {
  setup_();
  return HtmlService.createHtmlOutput(PAGE_HTML)
    .setTitle('Suivi muscu')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover')
    .addMetaTag('mobile-web-app-capable', 'yes')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/**
 * Porte d'entrée pour la version hébergée sur GitHub Pages.
 * La page envoie {fn, args} en JSON ; seules les fonctions listées ici sont appelables.
 * Nécessite un déploiement « Exécuter en tant que : Moi » + « Accès : Tout le monde ».
 */
function doPost(e) {
  var api = {
    getData: getData, saveSeance: saveSeance, deleteSeance: deleteSeance,
    saveProgramme: saveProgramme, deleteProgramme: deleteProgramme,
    saveExercice: saveExercice, deleteExercice: deleteExercice,
    saveReglages: saveReglages, getAgenda: getAgenda
  };
  var out;
  try {
    var req = JSON.parse(e.postData.contents);
    if (!Object.prototype.hasOwnProperty.call(api, req.fn)) throw new Error('Fonction inconnue : ' + req.fn);
    var result = api[req.fn].apply(null, req.args || []);
    out = { ok: true, result: result === undefined ? null : result };
  } catch (err) {
    out = { ok: false, error: String((err && err.message) || err) };
  }
  return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}

/* ---------- API appelée depuis la page ---------- */

/** Un seul appel au chargement : tout ce dont l'appli a besoin. */
function getData() {
  setup_();
  var reg = {};
  readTable_('Reglages').forEach(function (r) { reg[r.cle] = r.valeur; });
  return {
    exercices: readTable_('Exercices'),
    programmes: readTable_('Programmes'),
    programmeExercices: readTable_('ProgrammeExercices'),
    seances: readTable_('Seances'),
    series: readTable_('Series'),
    reglages: reg,
    info: { compte: Session.getEffectiveUser().getEmail(), sheet: ss_().getName() }
  };
}

/** Enregistre une séance terminée. payload = {programme_id, thematique, type, accompagne, duree_min, note, commentaire, muscles, exos:[{nom, series:[{reps,poids,ua}]}]} */
function saveSeance(payload) {
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var id = 'S' + new Date().getTime() + Math.floor(Math.random() * 1000);
    var date = new Date();
    var total = 0;
    var rows = [];
    (payload.exos || []).forEach(function (ex) {
      (ex.series || []).forEach(function (s, i) {
        var ua = Number(s.ua) || 0;
        total += ua;
        rows.push([id, date, ex.nom, i + 1, Number(s.reps) || 0, Number(s.poids) || 0, ua]);
      });
    });
    sheet_('Seances').appendRow([id, date, payload.programme_id || '', payload.thematique || '',
      payload.type || '', payload.accompagne ? 'oui' : 'non', Number(payload.duree_min) || 0,
      Number(payload.note) || 0, payload.commentaire || '', payload.muscles || '', total]);
    if (rows.length) {
      var sh = sheet_('Series');
      sh.getRange(sh.getLastRow() + 1, 1, rows.length, rows[0].length).setValues(rows);
    }
    return id;
  } finally {
    lock.releaseLock();
  }
}

function deleteSeance(id) {
  writeTable_('Seances', readTable_('Seances').filter(function (r) { return r.id !== id; }));
  writeTable_('Series', readTable_('Series').filter(function (r) { return r.seance_id !== id; }));
  return true;
}

/** prog = {id?, nom, thematique, type, ordre, exos:[{exercice, series, reps, poids, repos_s}]} */
function saveProgramme(prog) {
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var progs = readTable_('Programmes');
    var id = prog.id || ('P' + new Date().getTime());
    var row = { id: id, nom: prog.nom, thematique: prog.thematique, type: prog.type, ordre: Number(prog.ordre) || progs.length + 1 };
    var found = false;
    progs = progs.map(function (p) { if (p.id === id) { found = true; return row; } return p; });
    if (!found) progs.push(row);
    writeTable_('Programmes', progs);

    var pe = readTable_('ProgrammeExercices').filter(function (r) { return r.programme_id !== id; });
    (prog.exos || []).forEach(function (e, i) {
      pe.push({ programme_id: id, ordre: i + 1, exercice: e.exercice, series: Number(e.series) || 1,
        reps: Number(e.reps) || 0, poids: Number(e.poids) || 0, repos_s: Number(e.repos_s) || 90 });
    });
    writeTable_('ProgrammeExercices', pe);
    return id;
  } finally {
    lock.releaseLock();
  }
}

function deleteProgramme(id) {
  writeTable_('Programmes', readTable_('Programmes').filter(function (r) { return r.id !== id; }));
  writeTable_('ProgrammeExercices', readTable_('ProgrammeExercices').filter(function (r) { return r.programme_id !== id; }));
  return true;
}

/** ex = {nom, muscles, type_charge, consigne, image_url, ancien_nom?} */
function saveExercice(ex) {
  var list = readTable_('Exercices');
  var key = ex.ancien_nom || ex.nom;
  var row = { nom: ex.nom, muscles: ex.muscles, type_charge: ex.type_charge, consigne: ex.consigne || '', image_url: ex.image_url || '' };
  var found = false;
  list = list.map(function (e) { if (e.nom === key) { found = true; return row; } return e; });
  if (!found) list.push(row);
  writeTable_('Exercices', list);
  return true;
}

function deleteExercice(nom) {
  writeTable_('Exercices', readTable_('Exercices').filter(function (e) { return e.nom !== nom; }));
  return true;
}

function saveReglages(obj) {
  var cur = {};
  readTable_('Reglages').forEach(function (r) { cur[r.cle] = r.valeur; });
  Object.keys(obj).forEach(function (k) { cur[k] = obj[k]; });
  writeTable_('Reglages', Object.keys(cur).map(function (k) { return { cle: k, valeur: cur[k] }; }));
  return true;
}

/* ---------- Agenda Google ---------- */

/** Événements de l'agenda entre deux instants (en millisecondes). */
function getAgenda(startMs, endMs) {
  var calId = '';
  readTable_('Reglages').forEach(function (r) { if (r.cle === 'agenda_id') calId = String(r.valeur || '').trim(); });
  var cal = calId ? CalendarApp.getCalendarById(calId) : CalendarApp.getDefaultCalendar();
  if (!cal) throw new Error('Agenda introuvable : ' + calId);
  return cal.getEvents(new Date(startMs), new Date(endMs)).map(function (e) {
    return { titre: e.getTitle(), debut: e.getStartTime().getTime(), fin: e.getEndTime().getTime(), journee: e.isAllDayEvent() };
  });
}

/** À lancer une fois depuis l'éditeur : autorise l'accès au Sheet et à l'agenda, et affiche un diagnostic. */
function autoriserAgenda() {
  Logger.log('Compte utilisé : ' + Session.getEffectiveUser().getEmail());
  Logger.log('Google Sheet : ' + ss_().getName());
  setup_();
  var calId = '';
  readTable_('Reglages').forEach(function (r) { if (r.cle === 'agenda_id') calId = String(r.valeur || '').trim(); });
  var cal = calId ? CalendarApp.getCalendarById(calId) : CalendarApp.getDefaultCalendar();
  if (!cal) { Logger.log('Agenda introuvable : ' + calId + ' (ce compte n\'y a pas accès)'); return; }
  var now = new Date(), in7 = new Date(now.getTime() + 7 * 864e5);
  Logger.log('Agenda lu : ' + cal.getName() + ' — ' + cal.getEvents(now, in7).length + ' événement(s) dans les 7 prochains jours');
}

/* ---------- Accès au Sheet ---------- */

function sheet_(name) {
  return ss_().getSheetByName(PREFIX + name);
}

function readTable_(name) {
  var sh = sheet_(name);
  var values = sh.getDataRange().getValues();
  var head = SHEETS[name];
  var out = [];
  for (var i = 1; i < values.length; i++) {
    var r = values[i];
    if (r.join('') === '') continue;
    var o = {};
    head.forEach(function (h, j) {
      var v = r[j];
      o[h] = (v instanceof Date) ? v.toISOString() : v;
    });
    out.push(o);
  }
  return out;
}

function writeTable_(name, rows) {
  var sh = sheet_(name);
  var head = SHEETS[name];
  var last = sh.getLastRow();
  if (last > 1) sh.getRange(2, 1, last - 1, head.length).clearContent();
  if (!rows.length) return;
  var data = rows.map(function (o) {
    return head.map(function (h) {
      var v = o[h];
      if (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}T/.test(v)) return new Date(v);
      return v === undefined ? '' : v;
    });
  });
  sh.getRange(2, 1, data.length, head.length).setValues(data);
}

/** Crée les onglets de l'appli au premier lancement et les pré-remplit. */
function setup_() {
  var ss = ss_();
  var created = false;
  Object.keys(SHEETS).forEach(function (name) {
    if (!ss.getSheetByName(PREFIX + name)) {
      var sh = ss.insertSheet(PREFIX + name);
      sh.getRange(1, 1, 1, SHEETS[name].length).setValues([SHEETS[name]]).setFontWeight('bold');
      sh.setFrozenRows(1);
      created = true;
    }
  });
  if (created && readTable_('Exercices').length === 0) seed_();
}

